#!/usr/bin/env python3
"""Open the local dashboard, from the app menu or the terminal."""
import os
import sys
from pathlib import Path

if __name__ == "__main__":
    vmctl = Path(__file__).resolve().with_name("vmctl")
    os.execv(sys.executable, [sys.executable, "-u", str(vmctl), "web", "--open", *sys.argv[1:]])
