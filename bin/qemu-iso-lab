#!/usr/bin/env python3
"""Open the local dashboard, from the app menu or the terminal.

From a terminal it is `vmctl web --open`, in the foreground as before. From the app menu (no
terminal on stdin, a desktop session) the server starts in the background with no window,
its output in artifacts/.web/server.log, and stops by itself 15 minutes after the last page
closed (`--idle-exit`); a second click finds it running and only opens the page again.
"""
import os
import subprocess
import sys
from pathlib import Path

IDLE_EXIT_MINUTES = "15"
LOG_LIMIT = 1 << 20  # one previous log kept as server.log.1


def from_app_menu() -> bool:
    return not sys.stdin.isatty() and bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


if __name__ == "__main__":
    vmctl = Path(__file__).resolve().with_name("vmctl")
    command = [sys.executable, "-u", str(vmctl), "web", "--open", *sys.argv[1:]]
    if not from_app_menu():
        os.execv(sys.executable, command)
    log = vmctl.parent.parent / "artifacts" / ".web" / "server.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    if log.is_file() and log.stat().st_size > LOG_LIMIT:
        log.replace(log.with_name("server.log.1"))
    with open(log, "ab") as out:
        subprocess.Popen([*command, "--idle-exit", IDLE_EXIT_MINUTES], cwd=vmctl.parent.parent,
                         stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
