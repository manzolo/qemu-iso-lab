#!/usr/bin/env python3
"""The Textual dashboard (vmtui opens it when Textual is installed)."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

if __name__ == "__main__":
    try:
        from vmctl.tui_textual import Dashboard
    except ModuleNotFoundError as exc:
        if exc.name != "textual":
            raise
        print("The dashboard needs Textual. From the repository root, run:\n"
              "  python3 -m venv .venv-tui\n"
              "  .venv-tui/bin/python -m pip install -e '.[tui]'\n"
              "  vmtui              (or: vmtui --classic for the fzf/dialog menus)",
              file=sys.stderr)
        sys.exit(1)
    if sys.argv[1:2] == ["--widget"]:
        from vmctl.tui_widgets import main
        sys.exit(main(sys.argv[2:]))
    Dashboard().run()
