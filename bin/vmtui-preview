#!/usr/bin/env python3
"""Optional Textual dashboard, launched separately from the classic TUI."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

if __name__ == "__main__":
    try:
        from vmctl.tui_preview import Dashboard
    except ModuleNotFoundError as exc:
        if exc.name != "textual":
            raise
        print("The preview needs Textual. From the repository root, run:\n"
              "  python3 -m venv .venv-tui\n"
              "  .venv-tui/bin/python -m pip install -e '.[tui]'\n"
              "  make tui-preview", file=sys.stderr)
        sys.exit(1)
    Dashboard().run()
