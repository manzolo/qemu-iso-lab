from collections import Counter

counts = Counter((vm.get("meta") or {}).get("family", "") or "other" for vm in VMS.values())
for family, count in sorted(counts.items()):
    print(family)
    print(f"{family:<14} {count} VM" + ("s" if count != 1 else ""))
PY
)" "$ROOT_DIR" "$CONFIG_DIR"
}

# Flat catalog (used by tests and by the family-less fallback)
