vm_is_running_headless() {
    python3 -c "$PY_COMMON
runtime_str, _ = lifecycle.vm_runtime_status(sys.argv[3], VMS[sys.argv[3]])
raise SystemExit(0 if runtime_str.startswith(('tracked:', 'hostfwd:', 'running:')) else 1)" "$ROOT_DIR" "$CONFIG_DIR" "$1"
}

vm_status_summary() {
    local vm_name="$1"
    load_vm_facts "$vm_name"
    if [[ "${FACTS[running]:-0}" == "1" ]]; then
        printf '%s\n' "running"
    elif [[ "${FACTS[installed]:-0}" == "1" ]]; then
        printf '%s\n' "stopped, disk has data"
    elif [[ "${FACTS[prepared]:-0}" == "1" ]]; then
        printf '%s\n' "prepared, empty disk"
    else
        printf '%s\n' "not installed"
    fi
}

# ---------------------------------------------------------------------------
# Remotes
# ---------------------------------------------------------------------------

list_remote_menu_items() {
    python3 - "$CONFIG_DIR" <<'PY'
import json
import sys
from pathlib import Path

config_dir = Path(sys.argv[1])
path = config_dir / "remotes.json"
if not path.exists():
    raise SystemExit(0)
data = json.loads(path.read_text(encoding="utf-8"))
remotes = data.get("remotes", {})
if not isinstance(remotes, dict):
    raise SystemExit(0)
for name, remote in sorted(remotes.items()):
    if not isinstance(remote, dict):
        continue
    label = remote.get("label", name)
    target = remote.get("ssh_target", "")
    project = remote.get("project_dir", "")
    ports = f"{remote.get('local_spice_port', 5930)}->{remote.get('remote_spice_port', 5930)}"
    print(name)
    print(f"{label}  {target}  {ports}  {project}")
PY
}

remote_field() {
    python3 - "$CONFIG_DIR" "$1" "$2" <<'PY'
import json
import sys
from pathlib import Path

config_dir = Path(sys.argv[1])
remote_name = sys.argv[2]
field = sys.argv[3]
path = config_dir / "remotes.json"
data = json.loads(path.read_text(encoding="utf-8"))
remote = data.get("remotes", {}).get(remote_name)
if not isinstance(remote, dict):
    raise SystemExit(f"unknown remote: {remote_name}")
value = remote.get(field, "")
print(value)
PY
}

# ---------------------------------------------------------------------------
# VM workspace menu
# ---------------------------------------------------------------------------

emit_section() {
    local name="$1"
    if [[ "$name" == "─" ]]; then
        printf '__sep_rule\n%s\n' "───────────────────────────────────────────────────────────────────────────"
        return
    fi
    printf '__sep_%s\n━━━ %s %s\n' "$name" "$name" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

# The recommended action gets a ▶ marker and is where the cursor starts.
emit_action() {
    local tag="$1"
    local desc="$2"
    local marker="  "
    if [[ -n "$RECOMMENDED" && "$tag" == "$RECOMMENDED" ]]; then
        marker="▶ "
    fi
    printf '%s\n%s%-27s %s\n' "$tag" "$marker" "$tag" "$desc"
}

# Main install entry for the profile's flow (also the recommendation when the
# VM has no disk yet).
primary_install_action() {
    if [[ "${FACTS[has_omarchy]:-0}" == "1" ]]; then
        printf '%s\n' "Omarchy Bootstrap"
    elif [[ "${FACTS[has_archinstall]:-0}" == "1" ]]; then
        printf '%s\n' "Arch Bootstrap"
    elif [[ "${FACTS[has_preseed]:-0}" == "1" ]]; then
        printf '%s\n' "Debian Preseed Bootstrap"
    elif [[ "${FACTS[has_kickstart]:-0}" == "1" ]]; then
        printf '%s\n' "Kickstart Bootstrap"
    elif [[ "${FACTS[has_autoyast]:-0}" == "1" ]]; then
        printf '%s\n' "AutoYaST Bootstrap"
    elif [[ "${FACTS[has_alpine]:-0}" == "1" ]]; then
        printf '%s\n' "Alpine Bootstrap"
    elif [[ "${FACTS[has_pfsense]:-0}" == "1" ]]; then
        printf '%s\n' "pfSense Bootstrap"
    elif [[ "${FACTS[has_reactos]:-0}" == "1" ]]; then
        printf '%s\n' "ReactOS Bootstrap"
    elif [[ "${FACTS[has_windows]:-0}" == "1" ]]; then
        printf '%s\n' "Windows Bootstrap"
    elif [[ "${FACTS[has_autoinstall]:-0}" == "1" && "${FACTS[has_ssh]:-0}" == "1" ]]; then
        printf '%s\n' "Full Bootstrap"
    elif [[ "${FACTS[has_autoinstall]:-0}" == "1" ]]; then
        printf '%s\n' "Unattended Install"
    elif [[ "${FACTS[has_cloud_init]:-0}" == "1" ]]; then
        printf '%s\n' "Cloud-Init Flow"
    else
        printf '%s\n' "Guided Provision"
    fi
}

# Requires FACTS to be loaded.
recommended_action() {
    if [[ -n "${FACTS[job_status]:-}" && "${FACTS[job_status]}" != "completed" ]]; then
        printf '%s\n' "Installation Log"
    elif [[ "${FACTS[running]:-0}" == "1" ]]; then
        if [[ "${FACTS[has_ssh]:-0}" == "1" ]]; then
            printf '%s\n' "SSH Console"
        else
            printf '%s\n' "Stop VM"
        fi
    elif [[ "${FACTS[installed]:-0}" == "1" ]]; then
        printf '%s\n' "Boot Desktop"
    else
        primary_install_action
    fi
}

video_profile_desc() {
    local pref
    pref=$(video_pref_get "$current_vm")
    local default="${FACTS[video_default]:-none}"
    local variants=" ${FACTS[video_variants]:-} "
    if [[ -n "$pref" && "$variants" == *" $pref "* ]]; then
        printf 'Using %s for this VM (profile default: %s)\n' "$pref" "$default"
    else
        printf 'Using profile default (%s); pick another for this VM\n' "$default"
    fi
}

# One-line state summary for the workspace header. Requires FACTS.
vm_status_header() {
    local parts=()
    if [[ "${FACTS[running]:-0}" == "1" ]]; then
        local how="running"
        case "${FACTS[runtime]:-}" in
            tracked:*) how="running headless (pid ${FACTS[runtime]#tracked:})" ;;
            hostfwd:*) how="running, SSH on 127.0.0.1:${FACTS[runtime]#hostfwd:}" ;;
            running:*) how="running (pid ${FACTS[runtime]#running:})" ;;
        esac
        parts+=("● $how")
    elif [[ "${FACTS[job_status]:-}" == "running" ]]; then
        parts+=("preparing or provisioning")
    elif [[ "${FACTS[installed]:-0}" == "1" ]]; then
        parts+=("■ stopped, disk has data")
    elif [[ "${FACTS[prepared]:-0}" == "1" ]]; then
        parts+=("□ disk prepared but empty — pick an INSTALL action")
    else
        parts+=("○ not installed — pick an INSTALL action")
    fi
    if [[ -n "${FACTS[job_status]:-}" ]]; then
        parts+=("Installation: ${FACTS[job_status]}")
    fi
    if [[ "${FACTS[prepared]:-0}" == "1" ]]; then
        parts+=("disk ${FACTS[disk_actual]:-?} / ${FACTS[disk_virtual]:-?}")
    fi
    if [[ "${FACTS[iso_ready]:-0}" == "1" ]]; then
        parts+=("ISO ready")
    else
        parts+=("ISO missing (install actions download it)")
    fi
    if [[ -n "${FACTS[ssh_port]:-}" && "${FACTS[running]:-0}" != "1" ]]; then
        parts+=("SSH port ${FACTS[ssh_port]}")
    fi
    printf '%s' "${parts[0]}"
    local part
    for part in "${parts[@]:1}"; do
        printf ' · %s' "$part"
    done
    printf '\n'
}

vm_workspace_header() {
    if [[ "$UI_BACKEND" != "fzf" ]]; then
        vm_status_header
        printf '▶ = suggested next step\n'
        return
    fi
    local marker='○' status='Not installed' tone=90 disk='Not prepared' disk_label='DISK'
    local iso='Missing' iso_tone=33 ssh="${FACTS[ssh_port]:-—}"
    if [[ "${FACTS[running]:-0}" == "1" ]]; then
        marker='●'; status='Running'; tone=32
    elif [[ "${FACTS[installed]:-0}" == "1" ]]; then
        marker='■'; status='Stopped'; tone=36
    elif [[ "${FACTS[prepared]:-0}" == "1" ]]; then
        marker='□'; status='Empty disk'; tone=33
    fi
    if [[ "${FACTS[job_status]:-}" == "running" ]]; then
        marker='●'; status='Installing'; tone=33
    fi
    if [[ "${FACTS[prepared]:-0}" == "1" ]]; then
        disk="${FACTS[disk_actual]:-?} / ${FACTS[disk_virtual]:-?}"
    fi
    [[ "${FACTS[installed]:-0}" == "1" ]] && disk_label='DISK WITH DATA'
    if [[ "${FACTS[iso_ready]:-0}" == "1" ]]; then
        iso='Ready'; iso_tone=36
    fi
    # Pad only ASCII text: Bash printf counts the UTF-8 marker in bytes,
    # although it occupies just one terminal column.
    if (( $(term_cols) >= 88 )); then
        printf '\n  \e[90m%-18s  %-26s  %-12s  %s\e[0m\n' STATE "$disk_label" ISO 'SSH PORT'
        printf '  \e[1;%sm%s %-16s\e[0m  \e[1m%-26s\e[0m  \e[1;%sm%-12s\e[0m  \e[1m%s\e[0m\n\n' \
            "$tone" "$marker" "$status" "$disk" "$iso_tone" "$iso" "$ssh"
    else
        printf '\n  \e[90m%-18s  %s\e[0m\n' STATE "$disk_label"
        printf '  \e[1;%sm%s %-16s\e[0m  \e[1m%s\e[0m\n' "$tone" "$marker" "$status" "$disk"
        printf '  \e[90m%-18s  %s\e[0m\n' ISO 'SSH PORT'
        printf '  \e[1;%sm%-18s\e[0m  \e[1m%s\e[0m\n\n' "$iso_tone" "$iso" "$ssh"
    fi
    if [[ "${FACTS[running]:-0}" == "1" ]]; then
        local summary
        summary=$(vm_status_header)
        printf '  \e[90m%s\e[0m\n' "${summary%% ·*}"
    fi
    if [[ -n "${FACTS[job_status]:-}" ]]; then
        printf '  Installation: %s\n' "${FACTS[job_status]}"
    fi
    printf '  \e[36m▶\e[0m Suggested: \e[1m%s\e[0m\n' "$RECOMMENDED"
}

# list_vm_menu_items_unified NAME → tag/description pairs for the workspace.
# Only actions that make sense for this VM *right now* are listed.
list_vm_menu_items_unified() {
    load_vm_facts "$1"
    RECOMMENDED=$(recommended_action)
    build_vm_menu_items
}

# Same output, from FACTS already loaded in the calling shell (mapfile runs the
# producer in a subshell, so the loop loads facts itself and calls this).
build_vm_menu_items() {
    local installed="${FACTS[installed]:-0}"
    local running="${FACTS[running]:-0}"
    local has_ssh="${FACTS[has_ssh]:-0}"
    local has_cloud_init="${FACTS[has_cloud_init]:-0}"

    emit_section "INSTALL"
    if [[ -n "${FACTS[job_status]:-}" ]]; then
        emit_action "Installation Log" "${FACTS[job_status]} — view progress and errors"
    fi
    if [[ "${FACTS[job_status]:-}" == "running" ]]; then
        if [[ $running == "1" ]]; then
            emit_action "Attach Display" "Watch the installer in a VNC viewer"
        else
            emit_action "Attach Display" "Available when the installer VM starts"
        fi
        emit_action "Cancel Installation" "Stop the installation and VM; keep disk and logs"
        emit_action "Profile Details" "Review this VM configuration"
        emit_action "Back" "Return to the VM list; installation continues"
        return
    fi
    if [[ "${FACTS[has_omarchy]:-0}" == "1" ]]; then
        emit_action "Omarchy Bootstrap" "Official cidata install + NVIDIA post-install"
        emit_action "Omarchy Unattended Install" "Install from the official ISO and stop after reboot"
    elif [[ "${FACTS[has_archinstall]:-0}" == "1" ]]; then
        emit_action "Arch Bootstrap" "Fully automated pacstrap install + post-install (Arch, CachyOS)"
        emit_action "Arch Install (Interactive)" "Boot live ISO with pre-built archinstall config"
    elif [[ "${FACTS[has_preseed]:-0}" == "1" ]]; then
        emit_action "Debian Preseed Bootstrap" "Fully automated Debian install + post-install"
        emit_action "Guided Provision" "Fetch ISO, prepare artifacts, boot installer"
    elif [[ "${FACTS[has_kickstart]:-0}" == "1" ]]; then
        emit_action "Kickstart Bootstrap" "Fully automated AlmaLinux/RHEL install + post-install"
        emit_action "Guided Provision" "Fetch ISO, prepare artifacts, boot installer"
    elif [[ "${FACTS[has_autoyast]:-0}" == "1" ]]; then
        emit_action "AutoYaST Bootstrap" "Fully automated openSUSE install + post-install"
        emit_action "Guided Provision" "Fetch ISO, prepare artifacts, boot installer"
    elif [[ "${FACTS[has_alpine]:-0}" == "1" ]]; then
        emit_action "Alpine Bootstrap" "Fully automated setup-alpine install + post-install"
        emit_action "Guided Provision" "Fetch ISO, prepare artifacts, boot installer"
    elif [[ "${FACTS[has_pfsense]:-0}" == "1" ]]; then
        emit_action "pfSense Bootstrap" "Scripted pfSense install for the network lab router (rendered config.xml)"
        emit_action "Network Lab Plan" "Topology, forwards and install order of the lab"
    elif [[ "${FACTS[has_reactos]:-0}" == "1" ]]; then
        emit_action "ReactOS Bootstrap" "Fully automated ReactOS install (unattend.inf, install only)"
        emit_action "Guided Provision" "Prepare artifacts, boot the ReactOS BootCD by hand"
    elif [[ "${FACTS[has_windows]:-0}" == "1" ]]; then
        emit_action "Windows Bootstrap" "Fully automated autounattend install + OpenSSH post-install"
        emit_action "Guided Provision" "Prepare artifacts, boot the Windows installer by hand"
    elif [[ "${FACTS[has_autoinstall]:-0}" == "1" && $has_ssh == "1" ]]; then
        emit_action "Full Bootstrap" "Unattended install, first boot, and post-install"
        emit_action "Unattended Install" "Run the configured Ubuntu autoinstall flow"
        emit_action "Cloud-Init Flow" "Manual installer with first-boot handoff"
    elif [[ "${FACTS[has_autoinstall]:-0}" == "1" ]]; then
        emit_action "Unattended Install" "Run the configured Ubuntu autoinstall flow"
        emit_action "Guided Provision" "Fetch ISO, prepare artifacts, boot installer"
    elif [[ $has_cloud_init == "1" ]]; then
        emit_action "Cloud-Init Flow" "Manual installer with first-boot handoff"
        emit_action "Seeded Installer" "Boot installer with a generated cloud-init seed"
        emit_action "Guided Provision" "Fetch ISO, prepare artifacts, boot installer"
    else
        emit_action "Guided Provision" "Fetch ISO, prepare artifacts, boot installer"
        emit_action "Installer Only" "Boot the installer without preparation"
    fi

    emit_section "RUN"
    if [[ $running == "1" ]]; then
        # A VM can be running on a disk that has no OS yet (installer in
        # progress): Stop/SSH must be reachable regardless of `installed`.
        emit_action "Stop VM" "Graceful power-off of the running VM"
        emit_action "Attach Display" "Watch the screen of the headless VM in a VNC viewer"
        if [[ $has_ssh == "1" ]]; then
            emit_action "SSH Console" "Open a shell inside the VM"
            emit_action "Serial Console" "Attach to the serial port (ttyS0 login, pfSense menu); Ctrl-] detaches"
        fi
        emit_action "Boot Desktop" "Already running: restart with display, or open SSH"
    elif [[ $installed == "1" ]]; then
        emit_action "Boot Desktop" "Start the VM with display"
        emit_action "Boot Headless" "Start the VM in the background"
        if [[ $has_ssh == "1" ]]; then
            emit_action "SSH Console" "Open a shell inside the VM"
            emit_action "Serial Console" "Attach to the serial port (ttyS0 login, pfSense menu); Ctrl-] detaches"
        fi
        if [[ $has_cloud_init == "1" ]]; then
            emit_action "First Boot" "Start the VM with cloud-init enabled"
        fi
    fi
    emit_action "Export to libvirt" "Define the installed VM for virt-manager"
    emit_action "Remote SPICE" "Start this VM on a remote host and open SPICE viewer"

    emit_section "MAINTENANCE"
    emit_action "Remove from libvirt" "Remove definition and preserve the disk"
    emit_action "Video Profile" "$(video_profile_desc)"
    if [[ $has_ssh == "1" ]]; then
        emit_action "Post-Install" "Run configured SSH provisioning tasks"
    fi
    emit_action "Boot Check" "Run a headless smoke test"
    emit_action "Fetch ISO" "Download or validate the configured ISO"
    emit_action "Prepare VM" "Create disk and firmware artifacts"
    emit_action "Profile Details" "Review this VM configuration"

    emit_section "ADVANCED"
    emit_action "Clean VM" "Remove disk, firmware vars and artifacts for this VM"
    emit_action "Delete ISO" "Remove this VM's cached ISO"
    emit_action "Flash Empty Disk" "Write the VM disk to an empty physical device"
    emit_action "Force Flash" "Wipe and write a non-empty physical device"
    emit_action "Import Disk" "Read a physical device into the VM image"

    emit_section "─"
    emit_action "Back" "Return to the VM list"
}

# Safety net: the state may change between rendering the menu and choosing.
is_na_action() {
    local tag="$1"
    local vm_name="$2"
    case "$tag" in
        "Boot Desktop"|"Boot Headless")
            local disk
            disk=$(vm_disk_path "$vm_name")
            if [[ -z "$disk" ]]; then
                return 0
            fi
            local abs="$disk"
            [[ "$abs" != /* ]] && abs="$ROOT_DIR/$abs"
            [[ ! -f "$abs" ]]
            ;;
        "Stop VM")
            ! vm_is_running_headless "$vm_name"
            ;;
        "SSH Console"|"Post-Install")
            ! vm_has_ssh_provision "$vm_name"
            ;;
        *)
            return 1
            ;;
    esac
}

msg_na_action() {
    local tag="$1"
    local vm_name="$2"
    case "$tag" in
        "Boot Desktop"|"Boot Headless")
            msg_box "VM Not Installed" "VM '$vm_name' has no installed disk yet.\n\nRun an INSTALL action first (Bootstrap, Guided Provision, or Unattended Install)."
            ;;
        "Stop VM")
            msg_box "VM Not Running" "VM '$vm_name' is not running.\n\nStart it first with 'Boot Desktop' or 'Boot Headless'."
            ;;
        "SSH Console"|"Post-Install")
            msg_box "SSH Not Configured" "VM '$vm_name' has no 'ssh_provision' section in its profile.\n\nAdd one to vms/profiles/*.json to enable SSH actions."
            ;;
        *)
            msg_box "Not Available" "Action '$tag' is not available for VM '$vm_name'."
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Physical devices (flash / import)
# ---------------------------------------------------------------------------

list_empty_device_menu_items() {
    python3 - "$VMCTL" <<'PY'
import subprocess
import sys

vmctl = sys.argv[1]
result = subprocess.run(
    [vmctl, "list-empty-devices"],
    check=True,
    capture_output=True,
    text=True,
)
for line in result.stdout.splitlines():
    if not line.strip():
        continue
    path, size, model = (line.split("\t", 2) + ["-", "-"])[:3]
    print(path)
    print(f"{size:>10}  {model}")
PY
}

list_target_device_menu_items() {
    python3 - "$VMCTL" <<'PY'
import subprocess
import sys

vmctl = sys.argv[1]
result = subprocess.run(
    [vmctl, "list-target-devices"],
    check=True,
    capture_output=True,
    text=True,
)
for line in result.stdout.splitlines():
    if not line.strip():
        continue
    path, size, model = (line.split("\t", 2) + ["-", "-"])[:3]
    print(path)
    print(f"{size:>10}  {model}")
PY
}

# ---------------------------------------------------------------------------
# Running vmctl
# ---------------------------------------------------------------------------

is_detached_install() {
    case "$1" in
        bootstrap-*|install-unattended|install-omarchy) return 0 ;;
        *) return 1 ;;
    esac
}

run_vmctl_background() {
    local log_path
    if log_path=$(python3 - "$ROOT_DIR" "$current_vm" "$VMCTL" "$@" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from vmctl import tui_jobs
try:
    print(tui_jobs.start(Path(sys.argv[1]), sys.argv[2], sys.argv[3:]))
except (OSError, RuntimeError, ValueError) as exc:
    print(str(exc))
    raise SystemExit(1)
PY
    ); then
        msg_box "Installation Started" "'$current_vm' is installing in the background.\n\nYou can close the TUI; the full command continues.\nUse Installation Log for progress/errors and Attach Display once the VM is running.\n\nLog: $log_path"
    else
        msg_box "Installation Not Started" "$log_path"
        return 1
    fi
}

show_installation_log() {
    local log_path="$ROOT_DIR/artifacts/$current_vm/runtime/tui-job/output.log"
    clear
    printf 'Installation log: %s\nCtrl-C returns to the menu; installation continues.\n\n' "$log_path"
    tail -n 80 -f -- "$log_path" || true
}

run_vmctl() {
    if is_detached_install "$1"; then
        run_vmctl_background "$@"
        return $?
    fi
    clear
    printf 'Selected VM: %s\n' "$current_vm"
    printf '$ %q' "$VMCTL"
    for arg in "$@"; do
        printf ' %q' "$arg"
    done
    printf '\n\n'

    local started status=0
    started=$(date +%s)
    if "$VMCTL" "$@"; then
        printf '\nCommand completed successfully (%ss).\n' "$(( $(date +%s) - started ))"
    else
        status=$?
        printf '\nCommand failed with exit code %s (%ss).\n' "$status" "$(( $(date +%s) - started ))"
    fi
    pause_box
    return $status
}

# run_vmctl_video CMD NAME [ARGS...] — appends the remembered --video profile
run_vmctl_video() {
    local -a args=("$@")
    local -a video
    mapfile -t video < <(video_args)
    run_vmctl "${args[@]}" "${video[@]}"
}

remote_spice_session() {
    require_command ssh
    ensure_optional_command remote-viewer || return 0

    local remote_name
    local remote_target
    local remote_dir
    local local_port
    local remote_port
    local quoted_dir
    local quoted_vm
    local remote_cmd
    local tunnel_pid

    mapfile -t remote_items < <(list_remote_menu_items)
    if [[ ${#remote_items[@]} -eq 0 ]]; then
        msg_box "No Remotes" "Create vms/remotes.json first.\n\nUse vms/remotes.json.example as a template (Tools → Remote Hosts)."
        return 0
    fi

    remote_name=$(MENU_WIDTH=110 menu_choose_fit "Remote SPICE" "Choose a remote host" "${remote_items[@]}") || return 0
    remote_target=$(remote_field "$remote_name" "ssh_target")
    remote_dir=$(remote_field "$remote_name" "project_dir")
    local_port=$(remote_field "$remote_name" "local_spice_port")
    remote_port=$(remote_field "$remote_name" "remote_spice_port")

    if [[ ! "$local_port" =~ ^[0-9]+$ || ! "$remote_port" =~ ^[0-9]+$ ]]; then
        msg_box "Invalid Port" "SPICE ports must be numeric."
        return 0
    fi

    printf -v quoted_dir '%q' "$remote_dir"
    printf -v quoted_vm '%q' "$current_vm"
    remote_cmd="cd $quoted_dir && ./bin/vmctl start $quoted_vm --spice-port $remote_port --background"

    clear
    printf 'Remote VM: %s\n' "$current_vm"
    printf 'Remote host: %s\n' "$remote_target"
    printf 'Remote project: %s\n' "$remote_dir"
    printf 'SPICE tunnel: 127.0.0.1:%s -> %s:127.0.0.1:%s\n\n' "$local_port" "$remote_target" "$remote_port"

    printf '$ ssh -N -L %q %q &\n' "$local_port:127.0.0.1:$remote_port" "$remote_target"
    ssh -N -L "$local_port:127.0.0.1:$remote_port" "$remote_target" &
    tunnel_pid=$!
    sleep 1

    printf '$ ssh %q %q\n\n' "$remote_target" "$remote_cmd"
    if ! ssh "$remote_target" "$remote_cmd"; then
        kill "$tunnel_pid" >/dev/null 2>&1 || true
        wait "$tunnel_pid" >/dev/null 2>&1 || true
        pause_box
        return 0
    fi

    printf '\n$ remote-viewer %q\n\n' "spice://127.0.0.1:$local_port"
    remote-viewer "spice://127.0.0.1:$local_port" || true
    kill "$tunnel_pid" >/dev/null 2>&1 || true
    wait "$tunnel_pid" >/dev/null 2>&1 || true
    pause_box
}

# Interactive picker that stores the choice for this VM.
choose_video() {
    mapfile -t video_items < <(list_video_menu_items "$current_vm")
    local current
    current=$(effective_video)
    local selected
    selected=$(MENU_DEFAULT_ITEM="${current:-Default}" menu_choose_fit "Video Profile" \
        "Video profile used by every start/install action of '$current_vm'.\nRemembered until you change it." \
        "${video_items[@]}") || return 1
    if [[ "$selected" == "Default" || "$selected" == "__default__" ]]; then
        video_pref_clear "$current_vm"
        printf '\n'
    else
        video_pref_set "$current_vm" "$selected"
        printf '%s\n' "$selected"
    fi
}

prompt_post_install() {
    local vm_name="$1"
    local installer_label="$2"
    local has_ssh="${FACTS[has_ssh]:-0}"

    local -a opts=()
    if [[ $has_ssh == "1" ]]; then
        opts+=("Start headless + SSH post-install" "Boot headless and run SSH provisioning")
    fi
    opts+=("Start with display" "Boot the installed VM with display")
    opts+=("Done" "Return to the VM menu")

    local choice
    choice=$(menu_choose "Install complete" \
        "${installer_label} finished for '$vm_name'. What next?" \
        "${opts[@]}") || return 0

    case "$choice" in
        "Start headless + SSH post-install")
            run_vmctl start "$vm_name" --headless --background || return 0
            if [[ $has_ssh == "1" ]]; then
                run_vmctl post-install "$vm_name" || true
            fi
            ;;
        "Start with display")
            run_vmctl_video start "$vm_name" || true
            ;;
        "Done")
            ;;
    esac
}

resolve_action() {
    case "$1" in
        "Export to libvirt") printf '%s\n' export-libvirt ;;
        "Remove from libvirt") printf '%s\n' unexport-libvirt ;;
        "Profile Details") printf '%s\n' show ;;
        "Back") printf '%s\n' back ;;
        "Arch Bootstrap") printf '%s\n' bootstrap-archinstall ;;
        "Omarchy Bootstrap") printf '%s\n' bootstrap-omarchy ;;
        "Omarchy Unattended Install") printf '%s\n' install-omarchy ;;
        "Arch Install (Interactive)") printf '%s\n' install-archinstall ;;
        "Debian Preseed Bootstrap") printf '%s\n' bootstrap-preseed ;;
        "Kickstart Bootstrap") printf '%s\n' bootstrap-kickstart ;;
        "AutoYaST Bootstrap") printf '%s\n' bootstrap-autoyast ;;
        "Alpine Bootstrap") printf '%s\n' bootstrap-alpine ;;
        "Windows Bootstrap") printf '%s\n' bootstrap-windows ;;
        "pfSense Bootstrap") printf '%s\n' bootstrap-pfsense ;;
        "ReactOS Bootstrap") printf '%s\n' bootstrap-reactos ;;
        "Network Lab Plan") printf '%s\n' lab-plan ;;
        "Full Bootstrap") printf '%s\n' bootstrap-unattended ;;
        "Guided Install"|"Guided Provision") printf '%s\n' provision ;;
        "Boot Desktop") printf '%s\n' start ;;
        "Boot Headless") printf '%s\n' start-headless ;;
        "Remote SPICE") printf '%s\n' remote-spice ;;
        "SSH Console") printf '%s\n' shell ;;
        "Serial Console") printf '%s\n' console ;;
        "Attach Display") printf '%s\n' attach ;;
        "Fetch ISO") printf '%s\n' fetch-iso ;;
        "Prepare VM") printf '%s\n' prep ;;
        "Installer Only") printf '%s\n' install ;;
        "Unattended Install") printf '%s\n' full-auto-install ;;
        "Installation Log") printf '%s\n' installation-log ;;
        "Cancel Installation") printf '%s\n' cancel-install ;;
        "Cloud-Init Flow") printf '%s\n' cloud-init-install ;;
        "Seeded Installer") printf '%s\n' install-cloud-init ;;
        "Stop VM") printf '%s\n' stop ;;
        "Post-Install") printf '%s\n' post-install ;;
        "First Boot") printf '%s\n' start-cloud-init ;;
        "Boot Check") printf '%s\n' boot-check ;;
        "Video Profile") printf '%s\n' video-profile ;;
        "Clean VM") printf '%s\n' clean ;;
        "Delete ISO") printf '%s\n' delete-iso ;;
        "Status") printf '%s\n' status ;;
        "Remote Hosts") printf '%s\n' remote-hosts ;;
        "Clean All") printf '%s\n' clean-all ;;
        "Quit") printf '%s\n' quit ;;
        "Flash Empty Disk") printf '%s\n' flash ;;
        "Force Flash") printf '%s\n' flash-force ;;
        "Import Disk") printf '%s\n' import-device ;;
        __sep_*) printf '%s\n' noop ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# Common shape: confirm, run a vmctl command with the video profile, then
# offer the post-install follow-up on success.
run_installer_flow() {
    local title="$1"
    local message="$2"
    shift 2
    if confirm_box "$title" "$message"; then
        if run_vmctl_video "$@"; then
            is_detached_install "$1" && return 0
            load_vm_facts "$current_vm"
            prompt_post_install "$current_vm" "$title"
        fi
    fi
}

# confirm_device_path DEVICE → 0 when the user typed DEVICE exactly, 1 to cancel.
# Deliberately not pre-filled: this is the last safety check before a
# destructive write to a physical device. Typos get another try.
confirm_device_path() {
    local device="$1"
    local typed
    local attempt
    for attempt in 1 2 3; do
        typed=$(input_box "Confirm Device" \
            "Safety check for a destructive operation.\n\nType exactly   $device   and press Enter to proceed.\nPress Enter on an empty line to cancel.") || return 1
        if [[ -z "$typed" ]]; then
            return 1
        fi
        if [[ "$typed" == "$device" ]]; then
            return 0
        fi
        if [[ $attempt -lt 3 ]]; then
            msg_box "Mismatch" "You typed:  $typed\nExpected:   $device\n\nTry again ($(( 3 - attempt )) attempt(s) left)."
        fi
    done
    msg_box "Mismatch" "Device path did not match after 3 attempts. Operation cancelled."
    return 1
}

run_action() {
    local action
    action=$(resolve_action "$1")
    case "$action" in
        installation-log)
            show_installation_log
            ;;
        cancel-install)
            if confirm_box "Cancel Installation" "Force-stop the installation and VM '$current_vm'?\n\nUnsaved guest changes may be lost. The disk, ISO and logs are kept.\n\nTo reinstall from scratch afterward, use Clean VM, then the install action."; then
                run_vmctl cancel-install "$current_vm" || true
            fi
            ;;
        noop)
            return 0
            ;;
        show)
            run_vmctl show "$current_vm" || true
            ;;
        video-profile)
            choose_video >/dev/null || true
            ;;
        provision)
            run_installer_flow "Guided Provision" \
                "Guided install for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts if missing\n- start the installer" \
                provision "$current_vm"
            ;;
        cloud-init-install)
            run_installer_flow "Cloud-Init Flow" \
                "Start the guided manual install flow for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts if missing\n- boot the installer now\n\nWhen the OS install finishes you'll be offered the next step (boot + post-install)." \
                provision "$current_vm"
            ;;
        full-auto-install)
            run_installer_flow "Unattended Install" \
                "Run the configured Ubuntu autoinstall flow for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts if missing\n- boot the installer in unattended mode\n- exit when the installer reboots after finishing" \
                install-unattended "$current_vm"
            ;;
        install)
            run_installer_flow "Installer Only" \
                "Boot the installer for VM '$current_vm' without any preparation step?" \
                install "$current_vm"
            ;;
        install-cloud-init)
            run_installer_flow "Seeded Installer" \
                "Boot the installer for VM '$current_vm' with a generated cloud-init seed attached?" \
                install "$current_vm" --cloud-init
            ;;
        install-archinstall)
            run_installer_flow "Arch Install (Interactive)" \
                "Boot the Arch live ISO with a pre-built archinstall config disk for VM '$current_vm'?\n\nThis will:\n- generate archinstall-config.json + archinstall-creds.json\n- boot the live ISO with the config on /dev/vdb\n\nIn the live environment run:\n  mkdir -p /tmp/archconf\n  mount /dev/vdb /tmp/archconf\n  bash /tmp/archconf/run.sh" \
                install-archinstall "$current_vm"
            ;;
        install-omarchy)
            if confirm_box "Omarchy Unattended Install" "Install Omarchy from the official ISO using the profile's cidata configuration?\n\nThe VM stops when the installer reboots; start it afterwards to use the desktop."; then
                run_vmctl_video install-omarchy "$current_vm" || true
            fi
            ;;
        bootstrap-archinstall)
            if confirm_box "Arch Bootstrap" "Run the fully automated Arch-based (pacstrap) bootstrap for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts\n- boot the live ISO (Arch or CachyOS) headless via serial console\n- automatically trigger pacstrap, locale, user, GRUB\n- start the installed VM and run SSH post-install\n\nExpected time: ~15-30 min depending on download speed."; then
                run_vmctl bootstrap-archinstall "$current_vm" || true
            fi
            ;;
        bootstrap-omarchy)
            if confirm_box "Omarchy Bootstrap" "Run the official unattended Omarchy install for VM '$current_vm'?\n\nThis will:\n- download the Omarchy ISO if missing\n- install Omarchy from a cidata configuration\n- start the installed VM headless\n- run the NVIDIA post-install over SSH"; then
                run_vmctl bootstrap-omarchy "$current_vm" || true
            fi
            ;;
        bootstrap-unattended)
            if confirm_box "Full Bootstrap" "Run the fully unattended Ubuntu bootstrap flow for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts if missing\n- run the configured Ubuntu autoinstall flow\n- start the installed VM headless in the background\n- wait for SSH and run post-install actions\n\nUse this only when autoinstall and SSH provisioning are configured correctly."; then
                run_vmctl_video bootstrap-unattended "$current_vm" || true
            fi
            ;;
        bootstrap-preseed)
            if confirm_box "Debian Preseed Bootstrap" "Run the fully automated Debian preseed bootstrap for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts\n- boot the Debian netinst headless via serial console\n- automatically run preseed install + late_command (SSH keys, sudoers)\n- start the installed VM and run SSH post-install\n\nExpected time: ~10-15 min depending on download speed."; then
                run_vmctl bootstrap-preseed "$current_vm" || true
            fi
            ;;
        bootstrap-alpine)
            if confirm_box "Alpine Bootstrap" "Run the fully automated Alpine bootstrap for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk artifacts\n- boot the Alpine live ISO headless via serial console\n- run setup-alpine from an answer file, then the profile's chroot steps (packages, sudo, greetd)\n- start the installed VM and run SSH post-install\n\nExpected time: ~5 min depending on download speed."; then
                run_vmctl bootstrap-alpine "$current_vm" || true
            fi
            ;;
        bootstrap-windows)
            if confirm_box "Windows Bootstrap" "Run the fully automated Windows bootstrap for VM '$current_vm'?\n\nThis will:\n- rebuild the Windows ISO once without the 'Press any key' prompt (isos/*-noprompt.iso)\n- download the virtio-win driver ISO if missing\n- create disk and firmware artifacts\n- boot Windows Setup headless with autounattend.xml on a seed CD (watch it with Attach Display)\n- at first logon: virtio guest tools, OpenSSH Server, profile commands, then shutdown\n- start the installed VM and run post-install over SSH\n\nExpected time: ~20-40 min."; then
                run_vmctl bootstrap-windows "$current_vm" || true
            fi
            ;;
        bootstrap-pfsense)
            if confirm_box "pfSense Bootstrap" "Run the scripted pfSense install for VM '$current_vm'?\n\nThis will:\n- render config.xml from the network_lab topology (WAN slirp, LAN segment, NAT forwards)\n- build a per-VM unattended ISO from the local pfSense CE 2.7.2 ISO (xorriso + growisofs)\n- boot the installer headless (BIOS, ZFS on vtbd0) and wait for the completion token\n\nExpected time: ~5-10 min. Then: vmctl lab up"; then
                run_vmctl bootstrap-pfsense "$current_vm" || true
            fi
            ;;
        bootstrap-reactos)
            if confirm_box "ReactOS Bootstrap" "Run the unattended ReactOS install for VM '$current_vm'?\n\nThis will:\n- rebuild the BootCD once per profile with unattend.inf and Setup as the default boot entry (xorriso)\n- create the disk\n- boot Setup headless: text stage, GUI stage, first logon (watch it with Attach Display)\n- wait for the completion token on COM1 and the guest's own shutdown\n\nExpected time: ~5-10 min. No SSH post-install: ReactOS ships no server."; then
                run_vmctl bootstrap-reactos "$current_vm" || true
            fi
            ;;
        lab-plan)
            run_vmctl lab plan "$current_vm" || true
            ;;
        bootstrap-autoyast)
            if confirm_box "AutoYaST Bootstrap" "Run the fully automated openSUSE AutoYaST bootstrap for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts\n- boot the openSUSE DVD headless via serial console\n- run the AutoYaST profile (partitioning, patterns, chroot script)\n- start the installed VM and run SSH post-install\n\nExpected time: ~40 min depending on download speed."; then
                run_vmctl bootstrap-autoyast "$current_vm" || true
            fi
            ;;
        bootstrap-kickstart)
            if confirm_box "Kickstart Bootstrap" "Run the fully automated AlmaLinux/RHEL kickstart bootstrap for VM '$current_vm'?\n\nThis will:\n- download the ISO if missing\n- create disk and firmware artifacts\n- boot the AlmaLinux minimal ISO headless via serial console\n- automatically run kickstart install + %post (SSH keys, sudoers, SELinux)\n- start the installed VM and run SSH post-install\n\nExpected time: ~10 min depending on download speed."; then
                run_vmctl bootstrap-kickstart "$current_vm" || true
            fi
            ;;
        fetch-iso)
            run_vmctl fetch-iso "$current_vm" || true
            ;;
        prep)
            run_vmctl prep "$current_vm" || true
            ;;
        start)
            if [[ "${FACTS[running]:-0}" == "1" ]] || vm_is_running_headless "$current_vm"; then
                local -a opts=()
                opts+=("Attach Display" "Watch the screen of the running VM in a VNC viewer")
                if [[ "${FACTS[has_ssh]:-0}" == "1" ]]; then
                    opts+=("SSH Console" "Open an SSH session inside the running VM")
                fi
                opts+=("Restart with Display" "Stop the VM and start it again with display")
                opts+=("Cancel" "Return to the menu")
                local choice
                choice=$(menu_choose "VM Already Running" \
                    "VM '$current_vm' is already running.\nWhat do you want to do?" \
                    "${opts[@]}") || return 0
                case "$choice" in
                    "Attach Display")
                        run_vmctl attach "$current_vm" || true
                        ;;
                    "SSH Console")
                        run_vmctl shell "$current_vm" || true
                        ;;
                    "Restart with Display")
                        if confirm_box "Restart with Display" "Stop '$current_vm' and restart it with display?"; then
                            clear
                            printf 'Selected VM: %s\n\n' "$current_vm"
                            "$VMCTL" stop "$current_vm" || true
                            printf '\n'
                            run_vmctl_video start "$current_vm" || true
                        fi
                        ;;
                esac
                return 0
            fi
            run_vmctl_video start "$current_vm" || true
            ;;
        start-headless)
            if run_vmctl start "$current_vm" --headless --background && [[ "${FACTS[has_ssh]:-0}" == "1" ]]; then
                if confirm_box "Headless VM Started" "'$current_vm' is booting in the background.\n\nOpen an SSH console now? (waits for the guest to accept connections)"; then
                    run_vmctl shell "$current_vm" || true
                fi
            fi
            ;;
        start-cloud-init)
            run_vmctl_video start "$current_vm" --cloud-init || true
            ;;
        remote-spice)
            remote_spice_session
            ;;
        shell)
            run_vmctl shell "$current_vm" || true
            ;;
        attach)
            load_vm_facts "$current_vm"
            if [[ "${FACTS[job_status]:-}" == "running" && "${FACTS[running]:-0}" != "1" ]]; then
                msg_box "Display Not Ready" "The installation job is running, but the VM has not started yet.\n\nCheck Installation Log for progress, then try Attach Display again."
            else
                run_vmctl attach "$current_vm" || true
            fi
            ;;
        console)
            run_vmctl console "$current_vm" || true
            ;;
        stop)
            if confirm_box "Stop VM" "Power off '$current_vm'?\n\nvmctl tries a graceful shutdown first (QMP / SSH) and only then kills the process."; then
                run_vmctl stop "$current_vm" || true
            fi
            ;;
        export-libvirt|unexport-libvirt)
            run_vmctl "$action" "$current_vm" || true
            ;;
        post-install)
            run_vmctl post-install "$current_vm" || true
            ;;
        boot-check)
            run_vmctl boot-check "$current_vm" || true
            ;;
        clean)
            if confirm_box "Confirm Clean" "Remove artifacts for VM '$current_vm'?\n\nThis deletes the disk image, firmware vars and generated files under artifacts/$current_vm.\nThe cached ISO is kept."; then
                run_vmctl clean "$current_vm" || true
            fi
            ;;
        flash|flash-force)
            local force=0
            [[ "$action" == "flash-force" ]] && force=1
            local -a device_items
            if [[ $force -eq 1 ]]; then
                mapfile -t device_items < <(list_target_device_menu_items)
            else
                mapfile -t device_items < <(list_empty_device_menu_items)
            fi
            if [[ ${#device_items[@]} -eq 0 ]]; then
                if [[ $force -eq 1 ]]; then
                    msg_box "No Devices" "No removable target devices found."
                else
                    msg_box "No Empty Devices" "No empty removable devices found.\n\nUse 'Force Flash' to write to a non-empty device."
                fi
                return 0
            fi
            local title="Flash Empty Disk"
            [[ $force -eq 1 ]] && title="Force Flash"
            local selected_device
            selected_device=$(menu_choose_fit "$title" "Select the target device for '$current_vm'" "${device_items[@]}") || return 0
            local warning="Write the VM disk image to $selected_device?"
            if [[ $force -eq 1 ]]; then
                warning="WIPE $selected_device and write the VM disk image to it?\n\nALL DATA ON THE DEVICE WILL BE LOST."
            fi
            warning+="\n\nAfter copying, you may choose to expand a supported final NTFS partition. The default is No."
            if ! confirm_box "$title" "$warning"; then
                return 0
            fi
            confirm_device_path "$selected_device" || return 0
            if [[ $force -eq 1 ]]; then
                # --allocated-only needs the wipe, so it is offered on this path only.
                local copy_mode
                copy_mode=$(menu_choose_fit "$title" "Copy mode for '$current_vm' -> $selected_device" \
                    "full" "Write every sector, zeroing free space (slow on large images)" \
                    "allocated" "Copy allocated blocks only; free space keeps its previous bytes (much faster)") || return 0
                if [[ "$copy_mode" == "allocated" ]]; then
                    run_vmctl flash "$current_vm" --device "$selected_device" --confirm-device "$selected_device" --force-target --allocated-only || true
                else
                    run_vmctl flash "$current_vm" --device "$selected_device" --confirm-device "$selected_device" --force-target || true
                fi
            else
                run_vmctl flash "$current_vm" --device "$selected_device" --confirm-device "$selected_device" || true
            fi
            ;;
        import-device)
            local -a device_items
            mapfile -t device_items < <(list_target_device_menu_items)
            if [[ ${#device_items[@]} -eq 0 ]]; then
                msg_box "No Devices" "No removable source devices found."
                return 0
            fi
            local selected_device
            selected_device=$(menu_choose_fit "Import Disk" "Select the source device to import into '$current_vm'" "${device_items[@]}") || return 0
            local import_mode
            local -a import_flags=()
            import_mode=$(menu_choose_fit "Import Mode" "Import $selected_device into '$current_vm'" \
                "full" "Full partitions (existing import)" \
                "allocated" "Allocated blocks (partclone + ddrescue)" \
                "resume" "Resume allocated import (source unchanged)") || return 0
            case "$import_mode" in
                full) ;;
                allocated) import_flags=(--allocated-only) ;;
                resume) import_flags=(--allocated-only --resume) ;;
                *) return 0 ;;
            esac
            if ! confirm_box "Import Disk" "Read $selected_device into the disk image of '$current_vm'?\n\nThe current VM disk image will be REPLACED."; then
                return 0
            fi
            confirm_device_path "$selected_device" || return 0
            run_vmctl import-device "$current_vm" --device "$selected_device" --confirm-device "$selected_device" "${import_flags[@]}" || true
            ;;
        clean-all)
            if confirm_box "Confirm Clean All" "Remove artifacts for ALL configured VMs?\n\nEvery disk image under artifacts/ is deleted. Cached ISOs are kept."; then
                run_vmctl clean --all || true
            fi
            ;;
        delete-iso)
            if confirm_box "Confirm Delete ISO" "Delete the cached ISO for VM '$current_vm'?\n\nThis only removes the ISO file configured in the VM profile. It does not remove VM disks or generated artifacts."; then
                run_vmctl delete-iso "$current_vm" || true
            fi
            ;;
        status)
            run_vmctl status || true
            ;;
        status-all)
            run_vmctl status --all || true
            ;;
        remote-hosts)
            remote_hosts_menu_loop
            ;;
        back)
            return 1
            ;;
        quit)
            clear
            exit 0
            ;;
    esac
}

# vm_menu_hotkeys → "key=Tag" lines for the VM menu (FACTS and RECOMMENDED already loaded).
vm_menu_hotkeys() {
    printf '%s\n' \
        "alt-d=Boot Desktop" \
        "alt-u=$(primary_install_action)" \
        "alt-s=SSH Console" \
        "alt-a=Attach Display" \
        "alt-c=Serial Console" \
        "alt-x=Stop VM" \
        "alt-p=Post-Install" \
        "alt-enter=${RECOMMENDED:-}"
}

vm_menu_hotkey_hint() {
    printf '  \e[1mAlt\e[0m+ \e[1mD\e[0m desktop · \e[1mU\e[0m install · \e[1mS\e[0m ssh · \e[1mA\e[0m screen · \e[1mC\e[0m serial · \e[1mX\e[0m stop · \e[1mP\e[0m post-install · \e[1mEnter\e[0m suggested\n'
}

vm_menu_loop() {
    local vm_cursor=""
    while true; do
        load_vm_facts "$current_vm"
        RECOMMENDED=$(recommended_action)
        local -a menu_items=()
        mapfile -t menu_items < <(build_vm_menu_items)
        # Actions can disappear after a shutdown or an external start.
        local found=0 i
        for (( i=0; i<${#menu_items[@]}; i+=2 )); do
            [[ "${menu_items[i]}" == "$vm_cursor" ]] && found=1
        done
        (( found )) || vm_cursor="$RECOMMENDED"
        local header
        header=$(vm_workspace_header)
        # Alt shortcuts for the everyday actions (fzf only): each picks its entry when the
        # menu offers it right now and is a no-op otherwise. Alt-U is this profile's
        # unattended install, Alt-Enter the suggested action.
        local hotkeys hotkey_hint
        hotkeys=$(vm_menu_hotkeys)
        hotkey_hint=$(vm_menu_hotkey_hint)
        local selected
        selected=$(MENU_NO_TAGS=1 MENU_REFRESH=1 MENU_STYLED=1 MENU_HOTKEYS="$hotkeys" MENU_HOTKEY_HINT="$hotkey_hint" \
            MENU_DEFAULT_ITEM="${vm_cursor:-$RECOMMENDED}" MENU_CANCEL_LABEL="Back" MENU_WIDTH=96 \
            menu_choose_fit \
            "$current_vm — ${FACTS[label]:-}" \
            "$header" \
            "${menu_items[@]}") || return 0
        vm_cursor=""
        case "$selected" in
            "$MENU_REFRESH_TAG"$'\t'*)
                vm_cursor="${selected#*$'\t'}"
                continue
                ;;
            __sep_*)
                continue
                ;;
            "Back")
                return 0
                ;;
        esac
        if is_na_action "$selected" "$current_vm"; then
            msg_na_action "$selected" "$current_vm"
            continue
        fi
        run_action "$selected" || return 0
    done
}

# ---------------------------------------------------------------------------
# Tools / remotes
# ---------------------------------------------------------------------------

remote_hosts_menu_loop() {
    while true; do
        local selected
        selected=$(MENU_CANCEL_LABEL="Back" menu_choose \
            "Remote Hosts" \
            "Config: $CONFIG_DIR/remotes.json" \
            "Show Path" "Show local remotes config paths" \
            "Create Example" "Create vms/remotes.json from the example template" \
            "Edit Config" "Open vms/remotes.json with EDITOR") || return 0
        case "$selected" in
            "Show Path")
                msg_box "Remote Hosts" "Config:\n$CONFIG_DIR/remotes.json\n\nTemplate:\n$CONFIG_DIR/remotes.json.example"
                ;;
            "Create Example")
                if [[ -e "$CONFIG_DIR/remotes.json" ]]; then
                    msg_box "Already Exists" "$CONFIG_DIR/remotes.json already exists."
                elif [[ ! -f "$CONFIG_DIR/remotes.json.example" ]]; then
                    msg_box "Missing Template" "$CONFIG_DIR/remotes.json.example is missing."
                elif confirm_box "Create Remotes" "Create $CONFIG_DIR/remotes.json from the example template?"; then
                    cp "$CONFIG_DIR/remotes.json.example" "$CONFIG_DIR/remotes.json"
                    msg_box "Created" "Created $CONFIG_DIR/remotes.json.\n\nEdit it with your SSH target and project path."
                fi
                ;;
            "Edit Config")
                if [[ ! -e "$CONFIG_DIR/remotes.json" ]]; then
                    msg_box "Missing Config" "Create $CONFIG_DIR/remotes.json first."
                else
                    "${EDITOR:-nano}" "$CONFIG_DIR/remotes.json"
                fi
                ;;
        esac
    done
}

tools_menu_loop() {
    while true; do
        local selected
        selected=$(MENU_CANCEL_LABEL="Back" menu_choose \
            "Tools" \
            "Lab-wide commands" \
            "Status"       "Table of VMs with local state (vmctl status)" \
            "Status (all)" "Same table for the whole catalog (vmctl status --all)" \
            "Remote Hosts" "Configure saved SSH/SPICE remote hosts" \
            "Clean All"    "Remove artifacts for all configured VMs") || return 0
        case "$selected" in
            "Status") run_action "Status" ;;
            "Status (all)") run_action "status-all" ;;
            "Remote Hosts") remote_hosts_menu_loop ;;
            "Clean All") run_action "Clean All" ;;
        esac
    done
}

lab_menu_loop() {
    while true; do
        local -a items=()
        mapfile -t items < <(list_lab_menu_items)
        local selected
        selected=$(MENU_CANCEL_LABEL="Back" menu_choose \
            "Network Lab" \
            "pfSense router + Pi-hole DNS/DHCP + Lubuntu client on the isolated segment lab-lan (vmctl lab ...)" \
            "${items[@]}") || return 0
        case "$selected" in
            "Plan") run_vmctl lab plan || true ;;
            "Status") run_vmctl lab status || true ;;
            "Install")
                if confirm_box "Install the network lab" "Install pfsense-lab, pihole-lab and lubuntu-lab from empty disks?\n\nRequires the pfSense CE 2.7.2 ISO (local.json) and downloads Ubuntu 22.04.5.\nRefuses if one of the three disks already exists (Clean first).\n\nExpected time: ~30 min."; then
                    run_vmctl lab install || true
                fi
                ;;
            "Install + Export")
                if confirm_box "Install and export the network lab" "Install the three VMs from empty disks, then define and start them in libvirt (network lab-lan, host on 192.168.0.254)?\n\nExpected time: ~30 min."; then
                    run_vmctl lab install --export || true
                fi
                ;;
            "Up") run_vmctl lab up || true ;;
            "Down") run_vmctl lab down || true ;;
            "Check") run_vmctl lab check || true ;;
            "Export to libvirt") run_vmctl lab export || true ;;
            "Unexport") run_vmctl lab unexport || true ;;
            "Libvirt Round Trip") run_vmctl lab libvirt-test || true ;;
            "Clean")
                if confirm_box "Clean the network lab" "Stop and remove pfsense-lab, pihole-lab and lubuntu-lab (disks and artifacts; ISOs are kept)?\n\nRefused while the lab is defined in libvirt (Unexport first)."; then
                    run_vmctl lab clean || true
                fi
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Dashboard (main screen)
# ---------------------------------------------------------------------------

dash_mode="all"
dash_value=""

dash_filter_label() {
    case "$dash_mode" in
        all) printf 'all VMs\n' ;;
        installed) printf 'installed only\n' ;;
        running) printf 'running only\n' ;;
        family) printf 'family = %s\n' "$dash_value" ;;
        find) printf 'name contains "%s"\n' "$dash_value" ;;
    esac
}

choose_filter() {
    local selected
    selected=$(MENU_CANCEL_LABEL="Back" menu_choose \
        "Filter" "Which VMs should the dashboard list?" \
        "All"       "Every profile in the catalog" \
        "Installed" "Only VMs that have a disk image (installed or just prepared)" \
        "Running"   "Only VMs running right now" \
        "Family"    "Pick a distro family (arch, debian, fedora, ...)") || return 0
    case "$selected" in
        All) dash_mode="all"; dash_value="" ;;
        Installed) dash_mode="installed"; dash_value="" ;;
        Running) dash_mode="running"; dash_value="" ;;
        Family)
            local -a family_items
            mapfile -t family_items < <(list_family_menu_items)
            local family
            family=$(MENU_NO_TAGS=1 MENU_CANCEL_LABEL="Back" menu_choose_fit "Family" "Choose a distro family" "${family_items[@]}") || return 0
            dash_mode="family"
            dash_value="$family"
            ;;
    esac
}

choose_find() {
    local text
    text=$(input_box "Find VM" "Show only VMs whose profile name or title contains:" "$([[ $dash_mode == find ]] && printf '%s' "$dash_value")") || return 0
    if [[ -z "$text" ]]; then
        dash_mode="all"
        dash_value=""
    else
        dash_mode="find"
        dash_value="$text"
    fi
}

dashboard_header() {
    local total="$1" installed="$2" running="$3"
    if [[ "$UI_BACKEND" != "fzf" ]]; then
        printf '%s profiles · %s with data · %s running\n' "$total" "$installed" "$running"
        printf '● Running   ■ Disk with data   □ Empty disk   ○ No disk\n'
        return
    fi
    # Neutral labels and bright counters give the summary a clear hierarchy.
    # Match the status colors in the VM rows; leave the background to the terminal.
    printf '\n  \e[90m%-18s  %-18s  %s\e[0m\n' 'PROFILES' 'DISK WITH DATA' 'RUNNING'
    printf '  \e[1m%-18s\e[0m  \e[1;36m%-18s\e[0m  \e[1;32m● %s\e[0m\n\n' "$total" "$installed" "$running"
    printf '  \e[32m●\e[0m Running   \e[36m■\e[0m With data   \e[33m□\e[0m Empty   \e[90m○\e[0m No disk\n'
}

dashboard_loop() {
    local dash_cursor=""
    while true; do
        local -a rows=()
        mapfile -t rows < <(list_dashboard_items "$dash_mode" "$dash_value")
        local total installed running shown
        IFS=$'\t' read -r _ total installed running shown <<<"${rows[0]}"
        rows=("${rows[@]:1}")

        local -a items=(
            "__filter" "▸ Filter: $(dash_filter_label)  —  showing $shown of $total"
            "__find"   "▸ Find VM by name…"
        )
        if [[ ${#rows[@]} -gt 0 ]]; then
            items+=("${rows[@]}")
        else
            items+=("__none" "    (no VM matches this filter)")
        fi
        if catalog_has_network_lab; then
            items+=("__lab" "▸ Network Lab: pfSense · Pi-hole · Lubuntu  —  plan · install · up/down · check · libvirt")
        fi
        items+=(
            "__tools" "▸ Tools: status table · remote hosts · clean all"
            "__quit"  "▸ Quit"
        )

        local default
        # After a refresh the cursor stays where it was, not on the remembered VM.
        default="$dash_cursor"
        [[ -z "$default" ]] && default=$(state_get last-vm)
        [[ -z "$default" ]] && default="__filter"

        local columns="" header
        if [[ "$UI_BACKEND" == "fzf" ]]; then
            columns=$'\e[1;36m'"$(list_dashboard_items __header '')"$'\e[0m'
        fi
        header=$(dashboard_header "$total" "$installed" "$running")
        local selected
        selected=$(MENU_NO_TAGS=1 MENU_DEFAULT_ITEM="$default" MENU_CANCEL_LABEL="Quit" MENU_OK_LABEL="Open" MENU_WIDTH=100 \
            MENU_REFRESH=1 MENU_STYLED=1 MENU_COLUMN_HEADER="$columns" \
            MENU_HOTKEYS_RAW="$DASHBOARD_HOTKEYS" MENU_HOTKEY_HINT="$(dashboard_hotkey_hint)" \
            menu_choose_fit \
            "QEMU ISO Lab" \
            "$header" \
            "${items[@]}") || {
                clear
                exit 0
            }
        dash_cursor=""

        case "$selected" in
            "$MENU_REFRESH_TAG"$'\t'*)
                # State moves while the dashboard is open (an install finishes, a VM stops):
                # loop again to rebuild both the rows and the counters in the header.
                dash_cursor="${selected#*$'\t'}"
                ;;
            "$MENU_HOTKEY_TAG"$'\t'*)
                # Alt shortcut on the highlighted row: run that action for the VM under the
                # cursor without opening its menu, then come back with the cursor kept.
                local hotkey="${selected#*$'\t'}"
                local target="${hotkey#*$'\t'}"
                hotkey="${hotkey%%$'\t'*}"
                dash_cursor="$target"
                case "$target" in
                    __*|"") ;;
                    *) run_dashboard_hotkey "$hotkey" "$target" ;;
                esac
                ;;
            __filter) choose_filter ;;
            __find) choose_find ;;
            __tools) tools_menu_loop ;;
            __lab) lab_menu_loop ;;
            __quit) clear; exit 0 ;;
            __none) ;;
            *)
                current_vm="$selected"
                state_set last-vm "$current_vm"
                vm_menu_loop
                ;;
        esac
    done
}

# The dashboard shortcuts are the VM menu ones minus Alt-Enter: without the menu open
# there is no highlighted suggestion to run.
DASHBOARD_HOTKEYS="alt-d,alt-u,alt-s,alt-a,alt-c,alt-x,alt-p"

dashboard_hotkey_hint() {
    printf '  \e[1mAlt\e[0m+ \e[1mD\e[0m desktop · \e[1mU\e[0m install · \e[1mS\e[0m ssh · \e[1mA\e[0m screen · \e[1mC\e[0m serial · \e[1mX\e[0m stop · \e[1mP\e[0m post-install  \e[90m(highlighted VM)\e[0m\n'
}

# run_dashboard_hotkey KEY VM → the VM menu action bound to KEY, run for VM if the menu
# would offer it right now; otherwise a one-line note and back to the list.
run_dashboard_hotkey() {
    local key="$1" vm="$2"
    current_vm="$vm"
    state_set last-vm "$current_vm"
    load_vm_facts "$current_vm"
    RECOMMENDED=$(recommended_action)
    local action="" entry
    while IFS= read -r entry; do
        [[ "${entry%%=*}" == "$key" ]] && action="${entry#*=}"
    done < <(vm_menu_hotkeys)
    [[ -n "$action" ]] || return 0
    local -a menu_items=()
    mapfile -t menu_items < <(build_vm_menu_items)
    local offered=0 i
    for (( i=0; i<${#menu_items[@]}; i+=2 )); do
        [[ "${menu_items[i]}" == "$action" ]] && offered=1
    done
    if (( ! offered )); then
        msg_box "$vm" "'$action' is not available for this VM right now (${FACTS[label]:-})."
        return 0
    fi
    if is_na_action "$action" "$current_vm"; then
        msg_na_action "$action" "$current_vm"
        return 0
    fi
    run_action "$action" || true
}

# Kept for scripting compatibility: flat picker without state.
choose_vm() {
    mapfile -t vm_items < <(list_vm_menu_items)
    local selected
    selected=$(MENU_WIDTH=96 menu_choose_fit "VM Selection" "Choose a VM profile (type the first letter to jump)" "${vm_items[@]}") || return 1
    current_vm="$selected"
    return 0
}

main_menu_loop() {
    dashboard_loop
}

# Ctrl-C must not kill the TUI: with a (no-op) handler installed, the child
# that is running — fzf, dialog, a vmctl command, a text prompt — still gets
# SIGINT and stops, while this shell survives and returns to the previous menu.
# (`trap '' INT` would be wrong: children would inherit the ignore.)
install_interrupt_guard() {
    trap ':' INT
}

if [[ "${VMTUI_TEST_MODE:-0}" != "1" ]]; then
    install_interrupt_guard
    main_menu_loop
fi
