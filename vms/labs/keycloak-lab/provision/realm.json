{
  "realm": "lab",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 3600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "editor",
        "description": "May read /edit in the learning app"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lab-web",
      "name": "Python PKCE app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "web-lab-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18081/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:18081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:18081/",
        "backchannel.logout.url": "http://172.20.20.2:8000/backchannel-logout",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "lab-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "lab-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lab-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "service-lab-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "5"
      },
      "protocolMappers": [
        {
          "name": "lab-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "lab-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "credentials": [
        {
          "type": "password",
          "value": "alice-lab-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "editor"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Lab",
      "credentials": [
        {
          "type": "password",
          "value": "bob-lab-pass",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
