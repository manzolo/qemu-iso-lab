  "vms": {
    "debian-7": {
      "name": "Debian 7.11 GNOME (wheezy, unattended, preseed)",
      "extends": "debian-7-base",
      "meta": {
        "status": "experimental",
        "groups": [
          "debian-releases"
        ],
        "version": "1.0.0"
      },
      "notes": "Debian 7 (wheezy) from the archived netinst 7.11.0: the same preseed recipe as debian-gnome (Debian 13) with the archive mirror, no security pocket and expired-signature tolerance. Experimental until a live run passes (vmctl check-vms debian-7).",
      "preseed_config": {
        "tasks": [
          "gnome-desktop"
        ],
        "packages": [
          "qemu-guest-agent",
          "spice-vdagent",
          "gnome-shell"
        ],
        "hostname": "debian-7",
        "late_commands": [
          "install -d /etc/gdm3",
          "printf %s '[daemon]\\nAutomaticLoginEnable=true\\nAutomaticLogin={{user}}\\n' > /etc/gdm3/daemon.conf",
          "printf 'T0:23:respawn:/sbin/getty -L ttyS0 115200 vt100\\n' >> /etc/inittab",
          "printf 'Acquire::Check-Valid-Until \"false\";\\n' > /etc/apt/apt.conf.d/99vmctl-archive"
        ]
      },
      "ssh_provision": {
        "ssh_host_port": 2292,
        "ssh_key": null,
        "post_install_run": [
          "for i in $(seq 1 90); do pgrep -u {{user}} -x 'gnome-shell|gnome-session' >/dev/null && break; sleep 2; done; pgrep -u {{user}} -x 'gnome-shell|gnome-session' >/dev/null && dpkg-query -W -f='${Status}\\n' gnome-shell | grep -q 'install ok installed'"
        ]
      }
    },
    "debian-8": {
      "name": "Debian 8.11 GNOME (jessie, unattended, preseed)",
      "extends": "debian-8-base",
      "meta": {
        "status": "experimental",
        "groups": [
          "debian-releases"
        ],
        "version": "1.0.0"
      },
      "notes": "Debian 8 (jessie) from the archived netinst 8.11.1: the same preseed recipe as debian-gnome (Debian 13) with the archive mirror, no security pocket and expired-signature tolerance. Experimental until a live run passes (vmctl check-vms debian-8).",
      "preseed_config": {
        "tasks": [
          "gnome-desktop"
        ],
        "packages": [
          "qemu-guest-agent",
          "spice-vdagent",
          "gnome-shell"
        ],
        "hostname": "debian-8",
        "late_commands": [
          "install -d /etc/gdm3",
          "printf %s '[daemon]\\nAutomaticLoginEnable=true\\nAutomaticLogin={{user}}\\n' > /etc/gdm3/daemon.conf",
          "systemctl enable gdm3.service serial-getty@ttyS0.service",
          "systemctl set-default graphical.target",
          "printf 'Acquire::Check-Valid-Until \"false\";\\n' > /etc/apt/apt.conf.d/99vmctl-archive"
        ]
      },
      "ssh_provision": {
        "ssh_host_port": 2293,
        "ssh_key": null,
        "post_install_run": [
          "~/bin/verify-desktop --user \"{{user}}\" --service display-manager.service --package-manager dpkg --package gnome-shell --process gnome-shell"
        ]
      }
    },
