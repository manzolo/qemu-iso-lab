        "post_commands": [
          "# greetd autologin into niri-session for the lab user (Fedora's greetd package may create either user)\nGREETER_USER=greeter\ngetent passwd greeter >/dev/null || GREETER_USER=greetd\ngetent passwd \"$GREETER_USER\" >/dev/null || useradd -r -M -d /var/lib/greetd -s /usr/sbin/nologin greeter\ninstall -d -m 755 /etc/greetd\ncat > /etc/greetd/config.toml <<EOF\n[terminal]\nvt = 1\n\n[initial_session]\ncommand = \"niri-session\"\nuser = \"{{user}}\"\n\n[default_session]\ncommand = \"agreety --cmd niri-session\"\nuser = \"$GREETER_USER\"\nEOF\nsystemctl enable greetd.service\nsystemctl set-default graphical.target"
