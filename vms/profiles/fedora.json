{
  "bases": {
    "fedora-kickstart-base": {
      "meta": {
        "family": "fedora",
        "role": "desktop",
        "release_model": "stable",
        "status": "unattended"
      },
      "disk": {
        "path": "artifacts/{{name}}/disk.qcow2",
        "size": "40G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "efi",
        "code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/{{name}}/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 4096,
      "cpus": 2,
      "network": "user",
      "audio": true,
      "usb_tablet": true,
      "guest_agent": true,
      "clipboard": true,
      "video": {
        "default": "std",
        "installer_order": [
          "std",
          "safe"
        ],
        "variants": {
          "std": [
            "-device",
            "qxl-vga",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "kickstart_config": {
        "username": "lab",
        "fullname": "Lab User",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "keyboard_layout": "us",
        "locale": "en_US.UTF-8",
        "bootloader_options": "--timeout=2",
        "disk_device": "vda",
        "selinux": "enforcing",
        "firewall": "enabled"
      },
      "ssh_provision": {
        "user": "lab",
        "copy_from_host": [
          {
            "source": "vms/profile-files/common/bin/verify-desktop",
            "dest": "/home/{{user}}/bin/verify-desktop",
            "dest_mode": "755"
          }
        ]
      }
    }
  },
