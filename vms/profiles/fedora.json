      "iso": "isos/Fedora-Kinoite-ostree-x86_64-44-1.7.iso",
      "iso_url": "https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Kinoite/x86_64/iso/Fedora-Kinoite-ostree-x86_64-44-1.7.iso",
      "notes": "Plasma 6 Wayland with SDDM autologin; verifies an active local session, plasma-desktop, plasmashell and user-owned kwin_wayland. Compare kubuntu-24.04: Plasma 5.27 X11. The ostree ref is read from the ISO; %post only configures. Extra packages use rpm-ostree after installation and activate on reboot. Experimental pending clean live validation. Fedora 44 ships Plasma Login Manager. The first installed boot uses multi-user.target; SSH layers SDDM with rpm-ostree and selects its unit for the next deployment. Desktop checks run after the mandatory reboot.",
      "kickstart_config": {
        "hostname": "fedora-kinoite",
        "ostree": {
          "osname": "fedora",
          "remote": "fedora",
          "url": "file:///ostree/repo",
          "ref": "fedora/44/x86_64/kinoite",
          "ref_match": "kinoite"
        },
        "post_commands": [
          "install -d -m0755 /etc/sddm.conf.d\ncat > /etc/sddm.conf.d/autologin.conf <<'SDDMEOF'\n[Autologin]\nUser={{user}}\nSession=plasma.desktop\nSDDMEOF",
          "systemctl set-default multi-user.target",
          "systemctl enable sshd.service serial-getty@ttyS0.service"
        ]
      },
      "ssh_provision": {
        "ssh_host_port": 2261,
        "post_install_run": [
          "rpm-ostree status",
          "sudo rpm-ostree install --idempotent --allow-inactive sddm sddm-wayland-plasma qemu-guest-agent spice-vdagent",
          "sudo ln -sfn /usr/lib/systemd/system/sddm.service /etc/systemd/system/display-manager.service",
          "sudo systemctl set-default graphical.target"
        ],
        "verify_after_reboot": [
          "~/bin/verify-desktop --user \"{{user}}\" --service sddm.service --package-manager rpm --package plasma-desktop --process plasmashell",
          "pgrep -u \"{{user}}\" -x kwin_wayland",
          "rpm -q --qf '%{VERSION}\\n' plasma-desktop | grep -E '^6[.]'"
        ]
