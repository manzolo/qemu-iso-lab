    "fedora-niri-dms": {
      "name": "Fedora 44 + niri + DankMaterialShell",
      "meta": {
        "slug": "fedora",
        "family": "fedora",
        "role": "desktop",
        "release_model": "stable",
        "status": "unattended"
      },
      "iso": "isos/Fedora-Everything-netinst-x86_64-44.iso",
      "iso_discovery": {
        "index_url": "https://download.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/iso/",
        "pattern": "href=\"(Fedora-Everything-netinst-x86_64-44-[0-9.]+\\.iso)\"",
        "sort": "desc",
        "limit": 1
      },
      "iso_url": "https://fedora.mirror.garr.it/fedora/linux/releases/44/Everything/x86_64/iso/Fedora-Everything-netinst-x86_64-44-1.7.iso",
      "disk": {
        "path": "artifacts/fedora-niri-dms/disk.qcow2",
        "size": "32G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "efi",
        "code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/fedora-niri-dms/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 8192,
      "cpus": 4,
      "network": "user",
      "audio": true,
      "video": {
        "default": "virtio-gl",
        "headless": [
          "-device",
          "virtio-vga-gl",
          "-display",
          "egl-headless"
        ],
        "installer_order": [
          "std",
          "safe"
        ],
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "virtio-gl": [
            "-device",
            "virtio-vga-gl",
            "-display",
            "gtk,gl=on"
          ]
        }
      },
      "usb_tablet": true,
      "notes": "Same niri + DankMaterialShell desktop as arch-dms, on Fedora 44: kickstart from the Everything netinst (inst_repo points at the online repository), niri/quickshell from Fedora, DMS from the avengemedia COPRs in post-install. SELinux stays permissive because greetd is not covered by the Fedora policy.",
      "kickstart_config": {
        "hostname": "fedora-niri-dms",
        "username": "lab",
        "fullname": "Lab",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "Europe/Rome",
        "keyboard_layout": "it",
        "locale": "it_IT.UTF-8",
        "inst_repo": "https://download.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/",
        "ignore_missing_packages": true,
        "packages": [
          "@core",
          "openssh-server",
          "sudo",
          "dnf5-plugins",
          "git",
          "vim-enhanced",
          "bash-completion",
          "NetworkManager",
          "niri",
          "xwayland-satellite",
          "accountsservice",
          "greetd",
          "foot",
          "fuzzel",
          "polkit",
          "pipewire",
          "wireplumber",
          "pipewire-pulseaudio",
          "xdg-desktop-portal-gnome",
          "xdg-desktop-portal-gtk",
          "xdg-user-dirs",
          "xdg-utils",
          "wl-clipboard",
          "grim",
          "slurp",
          "nautilus",
          "gvfs",
          "udisks2",
          "brightnessctl",
          "playerctl",
          "pavucontrol",
          "upower",
          "power-profiles-daemon",
          "mesa-dri-drivers",
          "mesa-vulkan-drivers",
          "jetbrains-mono-fonts-all",
          "google-noto-sans-fonts",
          "google-noto-color-emoji-fonts",
          "papirus-icon-theme",
          "adwaita-icon-theme",
          "htop",
          "fastfetch",
          "ripgrep",
          "fd-find",
          "bat",
          "jq",
          "tree",
          "unzip",
          "rsync",
          "wget",
          "curl"
        ],
        "post_commands": [
          "# greetd autologin into niri-session for the lab user (Fedora's greetd package may create either user)\nGREETER_USER=greeter\ngetent passwd greeter >/dev/null || GREETER_USER=greetd\ngetent passwd \"$GREETER_USER\" >/dev/null || useradd -r -M -d /var/lib/greetd -s /usr/sbin/nologin greeter\ninstall -d -m 755 /etc/greetd\ncat > /etc/greetd/config.toml <<EOF\n[terminal]\nvt = 1\n\n[initial_session]\ncommand = \"niri-session\"\nuser = \"{{user}}\"\n\n[default_session]\ncommand = \"agreety --cmd niri-session\"\nuser = \"$GREETER_USER\"\nEOF\nsystemctl enable greetd.service\nsystemctl set-default graphical.target"
        ],
        "disk_device": "vda",
        "selinux": "permissive",
        "firewall": "enabled"
      },
      "ssh_provision": {
        "hostname": "fedora-niri-dms",
        "user": "lab",
        "ssh_host_port": 2233,
        "copy_from_host": [
          {
            "source": "vms/profile-files/fedora-niri-dms/bin/fedora-dms-post-install",
            "dest": "/home/{{user}}/bin/fedora-dms-post-install",
            "dest_mode": "755"
          },
          {
            "source": "vms/profile-files/arch-dms/niri/config.kdl",
            "dest": "/home/{{user}}/.config/niri/config.kdl",
            "dest_mode": "644"
          },
          {
            "source": "vms/profile-files/common/bin/verify-desktop",
            "dest": "/home/{{user}}/bin/verify-desktop",
            "dest_mode": "755"
          }
        ],
        "post_install_run": [
          "~/bin/fedora-dms-post-install",
          "command -v dms >/dev/null && dms version",
          "niri --version"
        ],
        "verify_after_reboot": [
          "~/bin/verify-desktop --user \"{{user}}\" --service greetd.service --package-manager rpm --package niri --compositor niri --process dms"
        ]
      }
    },
    "fedora-silverblue": {
      "name": "Fedora Silverblue 44 (immutable, kickstart + ostree)",
      "meta": {
        "slug": "silverblue",
        "family": "fedora",
        "role": "desktop",
        "release_model": "stable",
        "status": "unattended",
        "verified": "2026-09-07"
      },
      "iso": "isos/Fedora-Silverblue-ostree-x86_64-44-1.7.iso",
      "iso_urls": [
        "https://mirrors.mit.edu/fedora/linux/releases/44/Silverblue/x86_64/iso/Fedora-Silverblue-ostree-x86_64-44-1.7.iso"
      ],
      "iso_url": "https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Silverblue/x86_64/iso/Fedora-Silverblue-ostree-x86_64-44-1.7.iso",
      "disk": {
        "path": "artifacts/fedora-silverblue/disk.qcow2",
        "size": "40G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "efi",
        "code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/fedora-silverblue/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 4096,
      "cpus": 2,
      "network": "user",
      "audio": true,
      "usb_tablet": true,
      "guest_agent": true,
      "clipboard": true,
      "video": {
        "default": "std",
        "installer_order": [
          "std",
          "safe"
        ],
        "variants": {
          "std": [
            "-device",
            "qxl-vga",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "notes": "Fedora Silverblue through the kickstart flow, ported from kvm-lab. kickstart_config.ostree replaces the %packages transaction with ostreesetup: the tree comes from the repository on the ISO (file:///ostree/repo) and the ref is read from the media at bootstrap time, so a new Fedora release only needs the ISO swapped. GDM autologin from %post. rpm-ostree layering (guest agent, spice-vdagent) happens in the post-install and takes effect at the next boot: on an immutable system nothing can be dnf-installed into the running deployment. iso_urls names a concrete mirror because dl.fedoraproject.org sometimes answers the redirect with an HTML mirror page, which the downloader refuses; iso_url stays as the fallback.",
      "kickstart_config": {
        "hostname": "silverblue",
        "username": "lab",
        "fullname": "Lab User",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "keyboard_layout": "us",
        "locale": "en_US.UTF-8",
        "ostree": {
          "osname": "fedora",
          "remote": "fedora",
          "url": "file:///ostree/repo",
          "ref": "fedora/44/x86_64/silverblue",
          "ref_match": "silverblue"
        },
        "bootloader_options": "--timeout=2",
        "post_commands": [
          "install -d -m0755 /etc/gdm\ncat > /etc/gdm/custom.conf <<'GDMEOF'\n[daemon]\nWaylandEnable=true\nAutomaticLoginEnable=True\nAutomaticLogin={{user}}\nGDMEOF",
          "systemctl set-default graphical.target",
          "systemctl enable gdm.service",
          "systemctl enable sshd.service"
        ],
        "disk_device": "vda",
        "selinux": "enforcing",
        "firewall": "enabled"
      },
      "ssh_provision": {
        "user": "lab",
        "ssh_host_port": 2246,
        "ssh_key": null,
        "post_install_run": [
          "rpm-ostree status",
          "sudo rpm-ostree install --idempotent --allow-inactive qemu-guest-agent spice-vdagent || echo 'layering skipped'",
          "~/bin/verify-desktop --user \"{{user}}\" --service display-manager.service --package-manager rpm --package gnome-shell"
        ],
        "copy_from_host": [
          {
            "source": "vms/profile-files/common/bin/verify-desktop",
            "dest": "/home/{{user}}/bin/verify-desktop",
            "dest_mode": "755"
          }
        ]
      },
      "iso_sha256": "9ccec9b075a0a4358a7209b2667156aaeeec3a6a3c8d71cada45b57fca9b4682"
    }
  }
