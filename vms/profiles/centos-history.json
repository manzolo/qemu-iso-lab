{
  "bases": {
    "centos-history-base": {
      "meta": {
        "family": "rhel",
        "role": "installer",
        "release_model": "stable",
        "slug": "centos",
        "groups": [
          "centos-releases"
        ]
      },
      "disk": {
        "path": "artifacts/{{name}}/disk.qcow2",
        "size": "20G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "bios"
      },
      "machine": "pc",
      "cpus": 2,
      "memory_mb": 2048,
      "network": "user",
      "audio": false,
      "video": {
        "default": "safe",
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "usb_tablet": true
    }
  },
  "vms": {
    "centos-5": {
      "name": "CentOS 5.11 (legacy kickstart, netinstall from the vault)",
      "extends": "centos-history-base",
      "meta": {
        "status": "experimental",
        "version": "1.1.1",
        "role": "server"
      },
      "iso": "isos/CentOS-5.11-x86_64-netinstall.iso",
      "iso_url": "https://vault.centos.org/5.11/isos/x86_64/CentOS-5.11-x86_64-netinstall.iso",
      "iso_sha256": "9729c04a8a3ba57ed4e34ee5b96522879e6a3bcbf5582c3b6bcfd02bcfbacf8c",
      "memory_mb": 1024,
      "notes": "CentOS 5.11 (September 2014, kernel 2.6.18): bootstrap-kickstart in its legacy mode (kickstart_config.legacy el5): anaconda 11 reads the kickstart from the initrd and installs from the vault's plain-HTTP copy on linuxsoft.cern.ch (vault.centos.org redirects to HTTPS) (method= on the kernel line, url in the kickstart); no %end, zerombr yes, the sudoers rule in /etc/sudoers. OpenSSH 4.3: RSA key and the legacy SSH options. Its loader crashes on the host-name lookup after a DHCP lease from QEMU's user network, so the install uses the user network's fixed addresses and %post writes DHCP back. Born experimental (2026-09-30): vmctl check-vms centos-5 runs one.",
      "installer_boot": {
        "kernel": "isolinux/vmlinuz",
        "initrd": "isolinux/initrd.img"
      },
      "network_device": "e1000",
      "kickstart_config": {
        "legacy": "el5",
        "hostname": "centos-5",
        "username": "lab",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "keyboard_layout": "us",
        "locale": "en_US.UTF-8",
        "disk_device": "vda",
        "selinux": "enforcing",
        "inst_repo": "http://linuxsoft.cern.ch/centos-vault/5.11/os/x86_64",
        "packages": [
          "@core",
          "openssh-server",
          "sudo",
          "acpid"
        ],
        "post_commands": [
          "sed -i -e 's|^mirrorlist=|#mirrorlist=|' -e 's|^#baseurl=http://mirror.centos.org/centos/$releasever|baseurl=http://linuxsoft.cern.ch/centos-vault/5.11|' /etc/yum.repos.d/CentOS-Base.repo",
          "chkconfig acpid on",
          "chkconfig sshd on"
        ]
      },
      "ssh_provision": {
        "user": "lab",
        "ssh_host_port": 2348,
        "key_type": "rsa",
        "ssh_options": [
          "HostKeyAlgorithms=+ssh-rsa",
          "PubkeyAcceptedAlgorithms=+ssh-rsa",
          "KexAlgorithms=+diffie-hellman-group-exchange-sha1,diffie-hellman-group14-sha1"
        ],
        "post_install_run": [
          "pgrep -x sshd >/dev/null && sudo -n true",
          "grep -q 'CentOS release 5' /etc/redhat-release",
          "grep -q centos-vault /etc/yum.repos.d/CentOS-Base.repo"
        ]
      }
    },
    "centos-6": {
      "name": "CentOS 6.10 (legacy kickstart, minimal ISO)",
      "extends": "centos-history-base",
      "meta": {
        "status": "experimental",
        "version": "1.1.1",
        "role": "server"
      },
      "iso": "isos/CentOS-6.10-x86_64-minimal.iso",
      "iso_url": "https://vault.centos.org/6.10/isos/x86_64/CentOS-6.10-x86_64-minimal.iso",
      "iso_sha256": "7c0dee2a0494dabd84809b72ddb4b761f9ef92b78a506aef709b531c54d30770",
      "memory_mb": 1024,
      "notes": "CentOS 6.10 (July 2018, kernel 2.6.32, the last 6): bootstrap-kickstart in its legacy mode (kickstart_config.legacy el6): anaconda 13 reads the kickstart from the initrd (ks=file:/ks.cfg, no inst.* options before RHEL 7) and installs @core from the minimal ISO; %post points yum at the vault's plain-HTTP copy on linuxsoft.cern.ch (vault.centos.org now answers HTTP with a redirect to HTTPS, which the old loader and yum cannot follow). OpenSSH 5.3: RSA key and the legacy SSH options. Born experimental (2026-09-30): vmctl check-vms centos-6 runs one.",
      "installer_boot": {
        "kernel": "isolinux/vmlinuz",
        "initrd": "isolinux/initrd.img"
      },
      "kickstart_config": {
        "legacy": "el6",
        "hostname": "centos-6",
        "username": "lab",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "keyboard_layout": "us",
        "locale": "en_US.UTF-8",
        "disk_device": "vda",
        "selinux": "enforcing",
        "inst_repo": "cdrom",
        "packages": [
          "@core",
          "openssh-server",
          "sudo",
          "acpid"
        ],
        "post_commands": [
          "sed -i -e 's|^mirrorlist=|#mirrorlist=|' -e 's|^#baseurl=http://mirror.centos.org/centos/$releasever|baseurl=http://linuxsoft.cern.ch/centos-vault/6.10|' /etc/yum.repos.d/CentOS-Base.repo",
          "chkconfig acpid on",
          "chkconfig sshd on"
        ]
      },
      "ssh_provision": {
        "user": "lab",
        "ssh_host_port": 2347,
        "key_type": "rsa",
        "ssh_options": [
          "HostKeyAlgorithms=+ssh-rsa",
          "PubkeyAcceptedAlgorithms=+ssh-rsa",
          "KexAlgorithms=+diffie-hellman-group-exchange-sha1,diffie-hellman-group14-sha1"
        ],
        "post_install_run": [
          "pgrep -x sshd >/dev/null && sudo -n true",
          "grep -q 'CentOS release 6' /etc/redhat-release",
          "grep -q centos-vault /etc/yum.repos.d/CentOS-Base.repo"
        ]
      }
    },
    "centos-7": {
      "name": "CentOS 7.9.2009 (kickstart, minimal ISO)",
      "extends": "centos-history-base",
      "meta": {
        "status": "unattended",
        "version": "1.1.2",
        "role": "server",
        "verified": "2026-09-30"
      },
      "iso": "isos/CentOS-7-x86_64-Minimal-2009.iso",
      "iso_url": "https://vault.centos.org/7.9.2009/isos/x86_64/CentOS-7-x86_64-Minimal-2009.iso",
      "iso_sha256": "07b94e6b1a0b0260b94c83d6bb76b26bf7a310dc78d7a9c7432809fb9bc6194a",
      "memory_mb": 2048,
      "notes": "CentOS 7.9.2009 (November 2020, kernel 3.10, end of life June 2024): bootstrap-kickstart from the minimal ISO (packages on the medium, inst.repo=cdrom), @core plus sshd and the guest agent; %post points yum at vault.centos.org (mirror.centos.org is gone). CentOS 5 and 6 stay manual: their anaconda takes ks= and method= instead of inst.*, a legacy kickstart flow still to write. Anaconda 21 predates autopart --noswap (line 15 of the kickstart stopped the first live run, 2026-09-30): the profile asks for --type=plain alone. Anaconda 21 also writes ONBOOT=no for eth0 unless the network line says --onboot=yes: the installed system booted without network and SSH timed out at the banner (2026-09-30). First live PASS 2026-09-30 (296 s).",
      "guest_agent": true,
      "kickstart_config": {
        "username": "lab",
        "fullname": "Lab User",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "keyboard_layout": "us",
        "locale": "en_US.UTF-8",
        "disk_device": "vda",
        "selinux": "enforcing",
        "firewall": "enabled",
        "packages": [
          "@core",
          "openssh-server",
          "sudo",
          "qemu-guest-agent"
        ],
        "hostname": "centos-7",
        "inst_repo": "cdrom",
        "post_commands": [
          "sed -i -e 's|^mirrorlist=|#mirrorlist=|' -e 's|^#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|' /etc/yum.repos.d/CentOS-*.repo",
          "systemctl enable sshd.service serial-getty@ttyS0.service",
          "systemctl set-default multi-user.target"
        ],
        "autopart_options": "--type=plain",
        "network_options": "--onboot=yes --activate"
      },
      "ssh_provision": {
        "user": "lab",
        "ssh_host_port": 2340,
        "post_install_run": [
          "systemctl is-active sshd.service",
          "sudo -n true",
          ". /etc/os-release; printf '%s\\n' \"$PRETTY_NAME\"",
          "sudo yum -q -y makecache >/dev/null 2>&1 || sudo dnf -q -y makecache >/dev/null 2>&1; grep -l 'vault.centos.org' /etc/yum.repos.d/*.repo | head -1"
        ]
      }
    },
