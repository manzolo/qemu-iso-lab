      "ssh_provision": {
        "ssh_host_port": 2379,
        "post_install_run": [
          "id {{user}}",
          "test -f /etc/cloud/cloud-init.disabled",
          "command -v sudo nano tcpdump",
          "rc-service sshd status",
          "! rc-update show | grep -E 'cloud-(init|config|final)'",
          "grep -q '^ttyS0::' /etc/inittab"
        ]
      }
