{
  "vms": {
    "alpine-ci": {
      "name": "Alpine Linux Virt CI",
      "meta": {
        "slug": "alpine-linux",
        "family": "alpine",
        "role": "ci",
        "release_model": "stable",
        "status": "manual"
      },
      "iso": "isos/alpine-virt-3.24.1-x86_64.iso",
      "iso_url": "https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/x86_64/alpine-virt-3.24.1-x86_64.iso",
      "disk": {
        "path": "artifacts/alpine-ci/disk.qcow2",
        "size": "2G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "bios"
      },
      "machine": "pc",
      "memory_mb": 512,
      "cpus": 1,
      "network": "user",
      "audio": false,
      "video": {
        "default": "std",
        "variants": {
          "std": [
            "-vga",
            "std"
          ]
        }
      },
      "ci": {
        "accel": "tcg",
        "headless": true,
        "boot_from": "cdrom",
        "auto_input": [
          {
            "match": "boot:",
            "send": "\r"
          },
          {
            "match": "boot:",
            "send": "\n"
          }
        ],
        "expect": "login:",
        "timeout_sec": 180
      },
      "iso_sha256": "e73a6241bd5f3c5c2d4d38c02cc52c378c0415a7c888bd292066bf36e0f41a39"
    },
    "alpine-ci-installed": {
      "name": "Alpine Linux Virt Installed CI",
      "meta": {
        "slug": "alpine-linux",
        "family": "alpine",
        "role": "ci-installed",
        "release_model": "stable",
        "status": "manual"
      },
      "iso": "isos/alpine-virt-3.24.1-x86_64.iso",
      "iso_url": "https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/x86_64/alpine-virt-3.24.1-x86_64.iso",
      "disk": {
        "path": "artifacts/alpine-ci-installed/disk.qcow2",
        "size": "2G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "bios"
      },
      "machine": "pc",
      "memory_mb": 512,
      "cpus": 1,
      "network": "user",
      "audio": false,
      "video": {
        "default": "std",
        "variants": {
          "std": [
            "-vga",
            "std"
          ]
        }
      },
      "notes": "Use after a minimal manual install to validate boot-from-disk in CI-like headless conditions.",
      "ci": {
        "accel": "tcg",
        "headless": true,
        "boot_from": "disk",
        "expect": "login:",
        "timeout_sec": 120
      },
      "iso_sha256": "e73a6241bd5f3c5c2d4d38c02cc52c378c0415a7c888bd292066bf36e0f41a39"
    }
  }
}
