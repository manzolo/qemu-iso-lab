        "size": "40G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "efi",
        "code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/opensuse-tumbleweed-kde/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 4096,
      "cpus": 2,
      "network": "user",
      "audio": true,
      "video": {
        "default": "std",
        "installer_order": [
          "std",
          "safe"
        ],
        "variants": {
          "std": [
            "-device",
            "qxl-vga",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "usb_tablet": true,
      "guest_agent": true,
      "clipboard": true,
      "autoyast_config": {
        "hostname": "tumbleweed-kde",
        "username": "lab",
        "realname": "Lab User",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "keyboard_layout": "english-us",
        "language": "en_US",
        "disk_device": "vda",
        "install_repo": "https://download.opensuse.org/tumbleweed/repo/oss/",
        "autologin": true,
        "open_firewall_services": [
          "ssh"
        ],
        "default_target": "graphical",
        "products": [
          "openSUSE"
        ],
        "patterns": [
          "enhanced_base",
          "kde",
          "kde_plasma"
        ],
        "packages": [
          "openssh",
          "qemu-guest-agent",
          "spice-vdagent",
          "NetworkManager",
          "iproute2",
          "curl",
          "vim",
          "sddm"
        ],
        "enable_services": [
          "NetworkManager",
          "sshd",
          "qemu-guest-agent"
        ],
        "chroot_commands": [
          "sed -i 's/^DISPLAYMANAGER=.*/DISPLAYMANAGER=\"sddm\"/' /etc/sysconfig/displaymanager",
          "install -d -m0755 /etc/sddm.conf.d && printf '[Autologin]\\nUser={{user}}\\nSession=plasma.desktop\\n' > /etc/sddm.conf.d/autologin.conf"
        ],
        "final_reboot": true
      },
      "ssh_provision": {
        "user": "lab",
        "ssh_host_port": 2345,
        "ssh_key": null,
        "post_install_run": [
          "cat /etc/os-release",
          "systemctl is-active sshd",
          "~/bin/verify-desktop --user \"{{user}}\" --service display-manager.service --package-manager rpm --package plasma6-desktop --process plasmashell"
        ],
        "copy_from_host": [
          {
            "source": "vms/profile-files/common/bin/verify-desktop",
            "dest": "/home/{{user}}/bin/verify-desktop",
            "dest_mode": "755"
          }
        ]
      },
      "notes": "openSUSE Tumbleweed with KDE Plasma 6 through AutoYaST from the NET installer, like opensuse-tumbleweed-autoyast: the kde and kde_plasma patterns, SDDM as the display manager with autologin. First live PASS 2026-09-30 (728 s)."
