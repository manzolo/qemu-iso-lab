{
  "_comment": "Git-ignored personal overrides. Tracked profiles use the guest user 'lab' (password 'lab'); override the identity fields below and every {{user}} in paths/commands follows.",
  "vms": {
    "cachyos-desktop": {
      "name": "CachyOS (Local)",
      "ssh_provision": {
        "user": "YOUR_USER",
        "ssh_key": "~/.ssh/id_ed25519"
      },
      "archinstall_config": {
        "username": "YOUR_USER",
        "password": "YOUR_PASSWORD"
      }
    },
    "ubuntu-niri-gl": {
      "name": "Ubuntu 26.04 Niri (Local)",
      "autoinstall": {
        "username": "YOUR_USER",
        "realname": "YOUR_USER",
        "password_hash": "REPLACE_WITH_SHA512_HASH"
      },
      "cloud_init": {
        "user": "YOUR_USER",
        "ssh_authorized_keys_file": "~/.ssh/id_ed25519.pub",
        "ssh_key": "~/.ssh/id_ed25519",
        "copy_from_host": [
          {
            "source": "~/.config/niri/",
            "dest": "/home/{{user}}/.config/niri"
          },
          {
            "source": "~/.config/DankMaterialShell/",
            "dest": "/home/{{user}}/.config/DankMaterialShell"
          }
        ]
      }
    },
    "arch-noctalia": {
      "name": "Arch Linux + Noctalia 5 (Local)",
      "archinstall_config": {
        "username": "YOUR_USER",
        "password": "YOUR_PASSWORD"
      },
      "ssh_provision": {
        "user": "YOUR_USER"
      }
    },
    "arch-dms": {
      "name": "Arch Linux + niri + DankMaterialShell (Local)",
      "archinstall_config": {
        "username": "YOUR_USER",
        "password": "YOUR_PASSWORD"
      },
      "ssh_provision": {
        "user": "YOUR_USER",
        "copy_from_host": [
          {
            "source": "~/.config/niri/",
            "dest": "/home/{{user}}/.config/niri"
          },
          {
            "source": "~/.config/DankMaterialShell/",
            "dest": "/home/{{user}}/.config/DankMaterialShell"
          }
        ]
      }
    },
    "arch-dms-nvidia": {
      "name": "Arch Linux + niri + DMS + NVIDIA (Local)",
      "archinstall_config": {
        "username": "YOUR_USER",
        "password": "YOUR_PASSWORD"
      },
      "ssh_provision": {
        "user": "YOUR_USER",
        "copy_from_host": [
          {
            "source": "~/.config/niri/",
            "dest": "/home/{{user}}/.config/niri"
          },
          {
            "source": "~/.config/DankMaterialShell/",
            "dest": "/home/{{user}}/.config/DankMaterialShell"
          },
          {
            "source": "~/.zshrc",
            "dest": "/home/{{user}}/.zshrc",
            "dest_mode": "644"
          },
          {
            "source": "~/.gitconfig",
            "dest": "/home/{{user}}/.gitconfig",
            "dest_mode": "644"
          }
        ]
      }
    },
    "windows11-unattended": {
      "name": "Windows 11 (Local)",
      "iso": "/path/to/Win11_24H2_English_x64.iso",
      "windows_config": {
        "username": "YOUR_USER",
        "password": "YOUR_PASSWORD",
        "realname": "Your Name",
        "language": "en-US",
        "timezone": "W. Europe Standard Time"
      },
      "ssh_provision": {
        "user": "YOUR_USER"
      },
      "shared_dir": {
        "source": "~/Shared",
        "tag": "shared"
      }
    },
    "windowsxp-unattended": {
      "iso": "/path/to/WindowsXP.iso",
      "windowsxp_config": {
        "product_key": "XXXXX-XXXXX-XXXXX-XXXXX-XXXXX",
        "service_pack": "/path/to/WindowsXP-KB936929-SP3-x86-XXX.exe"
      }
    },
    "windowsnt4-unattended": {
      "iso": "/path/to/WindowsNT4-Workstation.iso",
      "windowsnt4_config": {
        "product_key": "XXX-XXXXXXX",
        "service_pack": "/path/to/SP6I386.EXE",
        "cdrom_driver_iso": "/path/to/Windows98.iso"
      }
    }
  }
}
