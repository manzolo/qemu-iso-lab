          },
          {
            "source": "vms/profile-files/proxmox/pve-community.sh",
            "dest": "/root/pve-community.sh",
            "dest_mode": "755"
          }
        ],
        "post_install_run": [
          "pveversion",
          "zpool status -x rpool | grep -q \"is healthy\"",
          "zpool list -v -H -P rpool | awk '$1 ~ /^mirror/ {m=1; next} m && $1 ~ /^\\// {n++} END {exit !(m && n == 2)}'",
          "proxmox-boot-tool status",
          "test \"$(proxmox-boot-tool status | grep -c 'is configured with')\" -eq 2",
          "timeout 180 sh -c 'until curl -ksf -o /dev/null https://127.0.0.1:8006/; do sleep 3; done'",
          "timeout 180 sh -c 'until systemctl is-active --quiet pveproxy && systemctl is-active --quiet pvedaemon && systemctl is-active --quiet pve-cluster; do sleep 3; done' || { systemctl status --no-pager pveproxy pvedaemon pve-cluster; exit 1; }",
          "/root/pve-repos.sh",
          "/root/pve-lan.sh 52:54:00:9e:0a:02 10.10.10.2/24",
          "/root/pve-community.sh 200 alpine-it-tools it-tools 80 10.0.2.100/24 10.10.10.20/24",
          "/root/pve-community.sh 201 glance glance 8080 10.0.2.101/24 10.10.10.21/24",
          "grep -q 'bridge-ports pvelan0' /etc/network/interfaces && test -f /etc/systemd/network/10-vmctl-pvelan.link",
          "grep -q 'learning off' /etc/network/interfaces"
        ]
      },
      "notes": "Proxmox VE on a ZFS RAID1 root over two virtio disks (vda + extra_disks vdb), installed by the vendor's automated installer from an answer file grafted on the ISO (bootstrap-proxmox). NIC 1 is NAT: SSH as root on 2276 with the project key, web GUI on https://127.0.0.1:8006 (root / lab). NIC 2 joins the pve-lan segment at runtime as vmbr1 10.10.10.2/24, shared with proxmox-lab-client. The installer only needs KVM; running guests inside it needs nested virtualization on the host. The post-install also creates two light LXC containers with the Proxmox VE Helper-Scripts (community-scripts.org, main branch, not pinned): IT-Tools (CT 200, http://10.10.10.20/) and Glance (CT 201, http://10.10.10.21:8080/), each on vmbr0 at a static NAT address outside slirp's DHCP pool and on vmbr1 at its lab address (lab_services).",
      "lab_services": [
        {
          "name": "IT-Tools",
          "container": 200,
          "script": "alpine-it-tools",
          "hostname": "it-tools",
          "port": 80,
          "nat_address": "10.0.2.100/24",
          "address": "10.10.10.20/24",
