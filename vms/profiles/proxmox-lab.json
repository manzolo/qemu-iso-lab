            "dest": "/home/{{user}}/bin/client-lan.sh",
            "dest_mode": "755"
          }
        ],
        "post_install_run": [
          "~/bin/verify-desktop --user \"{{user}}\" --service display-manager.service --package-manager dpkg --package xfce4 --process xfce4-session",
          "firefox-esr --version",
          "sudo ~/bin/client-lan.sh 52:54:00:9e:0a:10 10.10.10.10/24 https://10.10.10.2:8006/ http://10.10.10.20/ http://10.10.10.21:8080/",
          "nmcli -g ipv4.addresses connection show pve-lan | grep -q '10.10.10.10/24'",
          "test -x /usr/local/bin/vmctl-open-proxmox && grep -q vmctl-open-proxmox /etc/xdg/autostart/vmctl-open-proxmox.desktop"
        ]
      },
      "iso_sha256": "0b813535dd76f2ea96eff908c65e8521512c92a0631fd41c95756ffd7d4896dc",
      "guest_agent": true,
      "notes": "Light desktop for the Proxmox lab: debian-xfce plus firefox-esr, whose policies open https://10.10.10.2:8006/ (proxmox-ve on the pve-lan segment) as homepage and toolbar bookmark (plus IT-Tools and Glance, the LXC apps on proxmox-ve), and an autostart entry opens it at login once Proxmox answers. NIC 1 is NAT (SSH 2277), NIC 2 joins pve-lan at runtime with 10.10.10.10/24 through NetworkManager. Start proxmox-ve too (vmctl start proxmox-ve --background --headless) and the browser reaches the web GUI across the segment; the certificate is Proxmox's self-signed one.",
