          "spice-vdagent",
          "firefox-esr"
        ],
        "late_commands": [
          "install -d /etc/lightdm/lightdm.conf.d",
          "printf '[Seat:*]\\nautologin-user={{user}}\\nautologin-user-timeout=0\\nautologin-session=xfce\\n' > /etc/lightdm/lightdm.conf.d/vmctl-autologin.conf",
          "systemctl enable lightdm.service serial-getty@ttyS0.service",
          "systemctl set-default graphical.target",
          "install -d /etc/firefox/policies",
          "printf '%s\\n' '{\"policies\":{\"Homepage\":{\"URL\":\"https://10.10.10.2:8006/\",\"StartPage\":\"none\"},\"OverrideFirstRunPage\":\"\",\"OverridePostUpdatePage\":\"\",\"DisableTelemetry\":true,\"DontCheckDefaultBrowser\":true,\"Preferences\":{\"datareporting.policy.firstRunURL\":{\"Value\":\"\",\"Status\":\"locked\"},\"browser.sessionstore.resume_from_crash\":{\"Value\":false,\"Status\":\"locked\"}},\"DisplayBookmarksToolbar\":\"always\",\"NoDefaultBookmarks\":true,\"Bookmarks\":[{\"Title\":\"Proxmox VE\",\"URL\":\"https://10.10.10.2:8006/\",\"Placement\":\"toolbar\"},{\"Title\":\"PVE node 2\",\"URL\":\"https://10.10.10.3:8006/\",\"Placement\":\"toolbar\"},{\"Title\":\"PVE node 3\",\"URL\":\"https://10.10.10.4:8006/\",\"Placement\":\"toolbar\"},{\"Title\":\"IT-Tools\",\"URL\":\"http://10.10.10.20/\",\"Placement\":\"toolbar\"},{\"Title\":\"Glance\",\"URL\":\"http://10.10.10.21:8080/\",\"Placement\":\"toolbar\"}]}}' > /etc/firefox/policies/policies.json"
