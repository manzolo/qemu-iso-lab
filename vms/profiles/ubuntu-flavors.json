{
  "vms": {
    "lubuntu-24.04": {
      "name": "Lubuntu 24.04 LTS (LXQt)",
      "meta": {
        "slug": "lubuntu",
        "family": "debian",
        "role": "desktop",
        "release_model": "lts",
        "status": "unattended",
        "verified": "2026-09-07"
      },
      "iso": "isos/ubuntu-24.04.4-live-server-amd64.iso",
      "iso_url": "https://releases.ubuntu.com/24.04.4/ubuntu-24.04.4-live-server-amd64.iso",
      "disk": {
        "path": "artifacts/lubuntu-24.04/disk.qcow2",
        "size": "30G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "efi",
        "code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/lubuntu-24.04/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 4096,
      "cpus": 2,
      "network": "user",
      "audio": true,
      "usb_tablet": true,
      "clipboard": true,
      "video": {
        "default": "std",
        "installer_order": [
          "std",
          "safe"
        ],
        "variants": {
          "std": [
            "-device",
            "qxl-vga",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "notes": "Ubuntu Server 24.04.4 autoinstall + lubuntu-desktop, the kvm-lab flavor recipe on plain QEMU. The desktop metapackage is installed by the installer itself (autoinstall packages), sddm gets an autologin drop-in (written for sddm, lightdm and gdm3 alike: the metapackage decides which one lands) for the Lubuntu session and a getty on ttyS0 makes `vmctl console` a login prompt. Expect 30-40 minutes: the metapackage is downloaded during the install.",
      "autoinstall": {
        "hostname": "lubuntu",
        "username": "lab",
        "realname": "Lab User",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "keyboard_layout": "us",
        "storage_layout": "direct",
        "install_ssh": true,
        "packages": [
          "lubuntu-desktop",
          "spice-vdagent",
          "qemu-guest-agent"
        ]
      },
      "cloud_init": {
        "hostname": "lubuntu",
        "user": "lab",
        "write_files": [
          {
            "path": "/etc/sudoers.d/90-{{user}}-nopasswd",
            "permissions": "0440",
            "content": "{{user}} ALL=(ALL) NOPASSWD:ALL\n"
          },
          {
            "path": "/etc/sddm.conf.d/vmctl-autologin.conf",
            "permissions": "0644",
            "content": "[Autologin]\nUser={{user}}\nSession=Lubuntu\n"
          },
          {
            "path": "/etc/gdm3/custom.conf",
            "permissions": "0644",
            "content": "[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin={{user}}\n"
          }
        ],
        "runcmd": [
          "systemctl set-default graphical.target",
          "for dm in sddm gdm3 gdm lightdm sddm; do systemctl list-unit-files \"$dm.service\" >/dev/null 2>&1 && systemctl enable \"$dm\" && break; done",
          "groupadd -f autologin; groupadd -f nopasswdlogin; usermod -aG autologin,nopasswdlogin {{user}} || true",
          "systemctl enable --now serial-getty@ttyS0.service"
        ]
      },
      "ssh_provision": {
        "hostname": "lubuntu",
        "user": "lab",
        "ssh_host_port": 2240,
        "post_install_run": [
          "~/bin/verify-desktop --user \"{{user}}\" --service display-manager.service --package-manager dpkg --package lubuntu-desktop"
        ],
        "copy_from_host": [
          {
            "source": "vms/profile-files/common/bin/verify-desktop",
            "dest": "/home/{{user}}/bin/verify-desktop",
            "dest_mode": "755"
          }
        ]
      },
      "iso_sha256": "e907d92eeec9df64163a7e454cbc8d7755e8ddc7ed42f99dbc80c40f1a138433"
    },
