        "size": "96G",
        "format": "qcow2",
        "interface": "sata"
      },
      "firmware": {
        "type": "efi",
        "code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/windows11-template/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 12288,
      "cpus": 4,
      "network": "user",
      "network_device": "e1000e",
      "audio": true,
      "video": {
        "default": "safe",
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "usb_tablet": true
    }
  }
}
