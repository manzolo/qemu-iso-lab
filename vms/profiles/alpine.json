{
  "vms": {
    "alpine-niri": {
      "name": "Alpine Linux 3.24 + niri",
      "meta": {
        "slug": "alpine-linux",
        "family": "alpine",
        "role": "desktop",
        "release_model": "stable"
      },
      "iso": "isos/alpine-standard-latest-stable-x86_64.iso",
      "iso_discovery": {
        "index_url": "https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/x86_64/",
        "pattern": "href=\"(alpine-standard-\\d+\\.\\d+\\.\\d+-x86_64\\.iso)\"",
        "sort": "desc",
        "limit": 1
      },
      "iso_url": "https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/x86_64/alpine-standard-3.24.1-x86_64.iso",
      "disk": {
        "path": "artifacts/alpine-niri/disk.qcow2",
        "size": "16G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "bios"
      },
      "machine": "pc",
      "memory_mb": 4096,
      "cpus": 2,
      "network": "user",
      "audio": true,
      "video": {
        "default": "virtio-gl",
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "virtio-gl": [
            "-device",
            "virtio-vga-gl",
            "-display",
            "gtk,gl=on"
          ]
        }
      },
      "usb_tablet": true,
      "notes": "musl + OpenRC desktop: niri from the community repo, seatd for seat management, greetd autologin (pam_rundir provides XDG_RUNTIME_DIR; greetd runs initial_session once per boot, see /run/greetd.run). No DankMaterialShell here: quickshell is not packaged in Alpine. Installed unattended by bootstrap-alpine.",
      "alpine_config": {
        "hostname": "alpine-niri",
        "username": "lab",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "Europe/Rome",
        "keyboard_layout": "it",
        "disk_device": "vda",
        "kernel_flavor": "lts",
        "packages": [
          "niri",
          "xwayland-satellite",
          "foot",
          "fuzzel",
          "greetd",
          "greetd-agreety",
          "greetd-openrc",
          "pam-rundir",
          "wayland-libs-server",
          "wayland-libs-client",
          "libxkbcommon",
          "libinput",
          "mesa-dri-gallium",
          "mesa-egl",
          "mesa-gbm",
          "mesa-gl"
        ],
        "optional_packages": [
          "pipewire",
          "pipewire-pulse",
          "wireplumber",
          "polkit",
          "polkit-openrc",
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk",
          "xdg-user-dirs",
          "xdg-utils",
          "wl-clipboard",
          "grim",
          "slurp",
          "brightnessctl",
          "playerctl",
          "font-jetbrains-mono-nerd",
          "font-noto",
          "font-noto-emoji",
          "adwaita-icon-theme",
          "curl",
          "wget",
          "rsync",
          "jq",
          "ripgrep",
          "fd",
          "bat",
          "eza",
          "btop",
          "fastfetch",
          "tree",
          "unzip"
        ],
        "chroot_commands": [
          "grep -q pam_rundir /etc/pam.d/greetd || printf 'session optional pam_rundir.so\\n' >> /etc/pam.d/greetd",
          "rc-update add greetd default",
          "rc-update add polkit default 2>/dev/null || true",
          "cat > /etc/greetd/config.toml <<\"EOF\"\n[terminal]\nvt = 7\n\n[initial_session]\ncommand = \"dbus-run-session -- niri --session\"\nuser = \"{{user}}\"\n\n[default_session]\ncommand = \"agreety --cmd 'dbus-run-session -- niri --session'\"\nuser = \"greetd\"\nEOF"
        ]
      },
      "ssh_provision": {
        "hostname": "alpine-niri",
        "user": "lab",
        "ssh_host_port": 2234,
        "copy_from_host": [
          {
            "source": "vms/profile-files/alpine-niri/niri/config.kdl",
            "dest": "/home/{{user}}/.config/niri/config.kdl",
            "dest_mode": "644"
          }
        ],
        "post_install_run": [
          "niri validate",
          "niri --version",
          "rc-status default",
          "pgrep -x niri >/dev/null && echo 'niri session is running' || { echo 'niri session NOT running'; exit 1; }"
        ]
      }
    }
  }
}
