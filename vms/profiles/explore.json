      },
      "machine": "q35",
      "memory_mb": 8192,
      "cpus": 4,
      "network": "user",
      "audio": true,
      "usb_tablet": true,
      "video": {
        "default": "virtio-gl",
        "headless": [
          "-device",
          "virtio-vga",
          "-display",
          "none"
        ],
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "virtio-gl": [
            "-device",
            "virtio-vga-gl",
            "-display",
            "gtk,gl=on"
          ]
        }
      },
      "installer_boot": {
        "kernel": "arch/boot/x86_64/vmlinuz-linux",
        "initrd": "arch/boot/x86_64/initramfs-linux.img"
      },
      "pearos_config": {
        "hostname": "pearos",
        "username": "lab",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "Europe/Rome",
        "locale": "en_US.UTF-8",
        "keymap": "it",
        "session": "plasma",
        "disk_device": "vda"
      },
      "ssh_provision": {
        "hostname": "pearos",
        "user": "lab",
        "ssh_host_port": 2272,
        "copy_from_host": [
          {
            "source": "vms/profile-files/common/bin/verify-desktop",
            "dest": "/home/{{user}}/bin/verify-desktop",
            "dest_mode": "755"
          }
        ],
        "post_install_run": [
          "~/bin/verify-desktop --user \"{{user}}\" --service display-manager.service --package-manager pacman --package pearos-settings"
        ]
      },
      "notes": "Unattended counterpart of pearos-nicecore, on the same user-supplied ISO (see that profile for where to download it). pearOS installs with Calamares in unpackfs mode, which has no answer file: bootstrap-pearos reproduces what its own Calamares configuration and alg-* helpers do, unpacking the live squashfs onto the disk and configuring it, so no package is downloaded during the install."
    },
