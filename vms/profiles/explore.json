      ],
      "iso_size": 3699195904,
      "memory_mb": 4096,
      "archinstall_config": {
        "hostname": "endeavouros",
        "kernels": [
          "linux"
        ],
        "inherit_live_pacman_conf": true,
        "live_login_prompt": "EndeavourOS login:",
        "live_shell_prompt": "root@EndeavourOS",
        "live_kernel_append": "systemd.unit=multi-user.target",
        "packages": [
          "mkinitcpio",
          "endeavouros-keyring",
          "endeavouros-mirrorlist",
          "eos-hooks",
          "endeavouros-branding",
          "eos-rankmirrors",
          "plasma-desktop",
          "plasma-workspace",
          "plasma-nm",
          "plasma-pa",
          "kscreen",
          "breeze",
          "breeze-gtk",
          "sddm",
          "sddm-kcm",
          "konsole",
          "dolphin",
          "kate",
          "firefox",
          "mesa",
          "pipewire",
          "pipewire-alsa",
          "pipewire-pulse",
          "wireplumber",
          "noto-fonts",
          "ttf-dejavu",
          "xdg-user-dirs",
          "networkmanager",
          "sudo",
          "nano",
          "vim"
        ],
        "services": [
          "sddm",
          "NetworkManager",
          "serial-getty@ttyS0"
        ],
        "bootstrap_chroot_commands": [
          "install -d -m 755 /etc/sddm.conf.d && printf '[Autologin]\\nUser={{user}}\\nSession=plasma\\n' > /etc/sddm.conf.d/autologin.conf",
          "systemctl set-default graphical.target"
        ]
      },
      "ssh_provision": {
        "user": "lab",
        "ssh_host_port": 2356,
        "ssh_key": null,
        "copy_from_host": [
          {
            "source": "vms/profile-files/common/bin/verify-desktop",
            "dest": "/home/{{user}}/bin/verify-desktop",
            "dest_mode": "755"
          }
        ],
        "post_install_run": [
          "cat /etc/os-release",
          "~/bin/verify-desktop --user \"{{user}}\" --service display-manager.service --package-manager pacman --package plasma-desktop"
        ]
      },
      "notes": "EndeavourOS (Arch with its own repository and tools) with KDE Plasma on SDDM, installed with bootstrap-archinstall the way CachyOS is: the live ISO boots on the serial console in multi-user mode (no live Plasma, no Calamares), the host logs in as the live root (no password) and runs a pacstrap script from a seed CD with the live pacman.conf and mirrorlists copied into the target, so [endeavouros] stays. Plasma, SDDM autologin into the plasma session, NetworkManager, the ttyS0 getty. The ISO is on the EndeavourOS mirrors (SHA-512 next to it). mkinitcpio is named explicitly: pacstrap otherwise takes the [endeavouros] dracut as the initramfs provider, and without the eos-dracut hooks Calamares adds nothing writes /boot/vmlinuz-linux or an initramfs, so GRUB had nothing to boot and returned to the firmware (first live run). First live PASS 2026-09-30."
    },
