{
  "bases": {
    "slackware-history-base": {
      "meta": {
        "family": "slackware",
        "role": "desktop",
        "release_model": "fixed",
        "slug": "slackware",
        "groups": [
          "slackware-releases"
        ]
      },
      "disk": {
        "path": "artifacts/{{name}}/disk.qcow2",
        "size": "24G",
        "format": "qcow2",
        "interface": "ide"
      },
      "firmware": {
        "type": "bios"
      },
      "machine": "pc",
      "cpus": 2,
      "memory_mb": 2048,
      "network": "user",
      "network_device": "e1000",
      "video": {
        "default": "std",
        "headless": [
          "-vga",
          "std",
          "-display",
          "none"
        ],
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "installer_boot": {
        "kernel": "kernels/huge.s/bzImage",
        "initrd": "isolinux/initrd.img"
      },
      "slackware_config": {
        "username": "lab",
        "password": "lab",
        "timezone": "Europe/Rome",
        "keymap": "it",
        "locale": "it_IT.UTF-8",
        "xinitrc": "xinitrc.xfce",
        "packages": [
          "sudo",
          "iproute2"
        ]
      },
      "ssh_provision": {
        "user": "lab",
        "post_install_run": [
          "for i in $(seq 1 90); do pgrep -u {{user}} -x xfce4-session >/dev/null && break; sleep 2; done; pgrep -u {{user}} -x xfce4-session >/dev/null && { set -- /var/log/packages/xfce4-session-*; [ -e \"$1\" ]; }"
        ]
      }
    },
    "slackware-legacy-ssh-base": {
      "extends": "slackware-history-base",
      "ssh_provision": {
        "key_type": "rsa",
        "ssh_options": [
          "HostKeyAlgorithms=+ssh-rsa",
          "PubkeyAcceptedAlgorithms=+ssh-rsa",
          "KexAlgorithms=+diffie-hellman-group-exchange-sha256"
        ]
      }
    }
  },
  "vms": {
    "slackware-13.0": {
      "name": "Slackware 13.0 (Xfce 4.6, unattended, DVD script)",
      "extends": "slackware-legacy-ssh-base",
      "meta": {
        "status": "experimental",
        "version": "1.0.1"
      },
      "iso": "isos/slackware64-13.0-install-dvd.iso",
      "iso_url": "https://mirrors.slackware.com/slackware/slackware-iso/slackware64-13.0-iso/slackware64-13.0-install-dvd.iso",
      "iso_md5": "2b30f2fccf4e493c461f723b4dc21240",
      "slackware_config": {
        "hostname": "slackware-130",
        "series": [
          "a",
          "ap",
          "l",
          "n",
          "x",
          "xap"
        ],
        "packages": [
          "xfce"
        ]
      },
      "ssh_provision": {
        "hostname": "slackware-130",
        "ssh_host_port": 2334
      },
      "notes": "Slackware 13.0 (August 2009): the first 64-bit release, kernel 2.6.29, Xfce 4.6 (the xfce package sits in xap, OPT), KDE 4.2, OpenSSH 5.2 (RSA key and the legacy SSH options). The install runs from the DVD's own shell: vmctl/slackware.py partitions, installpkg --root from the DVD (ADD and REC of the a/ap/l/n/x/xap series plus sudo and xfce, minus the screensavers and the big xap applications), configures the target, tty1 logs the user in (agetty -l) and ~/.bash_profile starts Xfce with startx; LILO on the MBR, the huge kernel. Born experimental: vmctl check-vms slackware-13.0 runs one."
    },
    "slackware-13.37": {
      "name": "Slackware 13.37 (Xfce 4.6, unattended, DVD script)",
      "extends": "slackware-legacy-ssh-base",
