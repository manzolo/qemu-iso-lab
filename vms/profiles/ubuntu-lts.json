    "ubuntu-8.04-unattended": {
      "name": "Ubuntu 8.04.4 Desktop (unattended, d-i alternate)",
      "meta": {
        "slug": "ubuntu",
        "family": "debian",
        "role": "desktop",
        "release_model": "lts",
        "status": "unattended",
        "verified": "2026-09-12"
      },
      "iso": "isos/ubuntu-8.04.4-alternate-amd64.iso",
      "iso_url": "https://old-releases.ubuntu.com/releases/8.04.4/ubuntu-8.04.4-alternate-amd64.iso",
      "disk": {
        "path": "artifacts/ubuntu-8.04-unattended/disk.qcow2",
        "size": "16G",
        "format": "qcow2",
        "interface": "ide"
      },
      "firmware": {
        "type": "bios"
      },
      "machine": "pc",
      "memory_mb": 1024,
      "cpus": 2,
      "network": "user",
      "network_device": "e1000",
      "audio": true,
      "usb_tablet": true,
      "video": {
        "default": "std",
        "installer_order": [
          "std",
          "safe"
        ],
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ]
        }
      },
      "iso_sha256": "2a4d687fe8824db5c541c8ac40a42e71e8524cbce497a39a7346b92be5d85b6b",
      "installer_boot": {
        "kernel": "install/vmlinuz",
        "initrd": "install/initrd.gz"
      },
      "preseed_config": {
        "hostname": "ubuntu-804",
        "domain": "local",
        "username": "lab",
        "fullname": "Lab User",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "UTC",
        "locale": "en_US.UTF-8",
        "language": "en",
        "country": "US",
        "keyboard_layout": "us",
        "mirror_hostname": "old-releases.ubuntu.com",
        "mirror_directory": "/ubuntu",
        "tasks": [
          "ubuntu-desktop"
        ],
        "packages": [
          "openssh-server",
          "sudo"
        ],
        "upgrade": "none",
        "disk_device": "auto",
        "extra": [
          "d-i apt-setup/services-select multiselect",
          "d-i pkgsel/update-policy select none",
          "d-i pkgsel/install-language-support boolean false"
        ],
        "late_commands": [
          "printf '[daemon]\\nAutomaticLoginEnable=true\\nAutomaticLogin={{user}}\\nTimedLoginEnable=false\\n' > /etc/gdm/gdm.conf-custom",
          "printf 'start on runlevel 2\\nstart on runlevel 3\\nstart on runlevel 4\\nstart on runlevel 5\\nstop on runlevel 0\\nstop on runlevel 1\\nstop on runlevel 6\\nrespawn\\nexec /sbin/getty -L 115200 ttyS0 vt102\\n' > /etc/event.d/ttyS0",
          "sed -i 's/^Prompt=.*/Prompt=never/' /etc/update-manager/release-upgrades",
          "for k in /apps/gnome-screensaver/lock_enabled /apps/gnome-screensaver/idle_activation_enabled; do gconftool-2 --direct --config-source xml:readwrite:/etc/gconf/gconf.xml.mandatory --type bool --set $k false; done",
          "printf '%s\\n' 'APT::Periodic::Enable \"0\";' 'APT::Periodic::Update-Package-Lists \"0\";' 'APT::Periodic::Download-Upgradeable-Packages \"0\";' > /etc/apt/apt.conf.d/10periodic"
        ]
      },
      "ssh_provision": {
        "hostname": "ubuntu-804",
        "user": "lab",
        "ssh_host_port": 2252,
        "post_install_run": [
          "for i in $(seq 1 90); do pgrep -u {{user}} -x 'gnome-session|x-session-manag(er)?' >/dev/null && break; sleep 2; done; pgrep -u {{user}} -x 'gnome-session|x-session-manag(er)?' >/dev/null && dpkg-query -W -f='${Status}\\n' ubuntu-desktop | grep -q 'install ok installed'"
        ],
        "key_type": "rsa",
        "ssh_options": [
          "HostKeyAlgorithms=+ssh-rsa",
          "PubkeyAcceptedAlgorithms=+ssh-rsa",
          "KexAlgorithms=+diffie-hellman-group-exchange-sha256"
        ]
      },
      "notes": "OpenSSH 4.7 in the guest: RSA key, SHA-1 signatures and DH group exchange (ssh_options)."
    },
