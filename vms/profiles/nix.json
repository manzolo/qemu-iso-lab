    "nixos-server": {
      "name": "NixOS 25.11 Server (unattended)",
      "meta": {
        "slug": "nixos",
        "family": "nix",
        "role": "server",
        "release_model": "channel-based",
        "status": "unattended",
        "verified": "2026-09-19"
      },
      "iso": "isos/latest-nixos-minimal-x86_64-linux.iso",
      "iso_url": "https://channels.nixos.org/nixos-25.11/latest-nixos-minimal-x86_64-linux.iso",
      "disk": {
        "path": "artifacts/nixos-server/disk.qcow2",
        "size": "24G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "efi",
