        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/nixos-server/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 4096,
      "cpus": 4,
      "network": "user",
      "usb_tablet": true,
      "audio": false,
      "nixos_config": {
        "hostname": "nixos",
        "username": "lab",
        "password_hash": "$6$labsalt0$POq.mGL6qhDmEnplwYiYiuKyYy.U8EuL0G.ROmcWjbMIHXpKeoKRB6MI2ObMDS3NHOQiB/R9E4pAiaNp5HKou/",
        "timezone": "Europe/Rome",
        "locale": "en_US.UTF-8",
        "keymap": "it",
        "state_version": "25.11",
        "desktop": "none",
        "disk_device": "vda",
        "packages": [
          "git",
          "vim",
          "curl",
          "htop"
        ]
      },
      "ssh_provision": {
        "hostname": "nixos",
        "user": "lab",
        "ssh_host_port": 2273,
        "post_install_run": [
          "nixos-version",
          "systemctl is-system-running --wait || systemctl --failed --no-pager",
          "sudo -n true && echo \"passwordless sudo ok\"",
          "nix-store --verify --check-contents >/dev/null && echo \"nix store consistent\""
        ]
      },
      "notes": "Declarative install: bootstrap-nixos partitions the disk, lets nixos-generate-config write the hardware part and installs the configuration.nix rendered from nixos_config. No answer file exists for NixOS because none is needed.",
      "video": {
        "default": "std",
        "headless": [
          "-vga",
          "std",
          "-display",
          "none"
        ],
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
