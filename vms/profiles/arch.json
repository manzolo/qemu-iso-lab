    "cachyos-local": {
      "name": "CachyOS + niri + Noctalia",
      "meta": {
        "catalog_slug": "cachyos",
        "family": "arch",
        "role": "desktop",
        "release_model": "rolling"
      },
      "iso": "isos/cachyos-desktop-linux-latest.iso",
      "iso_discovery": {
        "index_url": "https://mirror.cachyos.org/ISO/desktop/",
        "pattern": "href=\"(\\d{6})/\"",
        "url_template": "https://mirror.cachyos.org/ISO/desktop/{match}/cachyos-desktop-linux-{match}.iso",
        "sort": "desc",
        "limit": 1
      },
      "iso_url": "https://mirror.cachyos.org/ISO/desktop/260809/cachyos-desktop-linux-260809.iso",
      "installer_boot": {
        "kernel": "arch/boot/x86_64/vmlinuz-linux-cachyos",
        "initrd": "arch/boot/x86_64/initramfs-linux-cachyos.img"
      },
      "disk": {
        "path": "artifacts/cachyos-local/disk.qcow2",
        "size": "32G",
        "format": "qcow2",
        "interface": "virtio"
      },
      "firmware": {
        "type": "efi",
        "code": "/usr/share/OVMF/OVMF_CODE_4M.fd",
        "vars_template": "/usr/share/OVMF/OVMF_VARS_4M.fd",
        "vars_path": "artifacts/cachyos-local/OVMF_VARS.fd"
      },
      "machine": "q35",
      "memory_mb": 4096,
      "cpus": 4,
      "network": "user",
      "audio": true,
      "video": {
        "default": "virtio-gl",
        "headless": [
          "-device",
          "virtio-vga-gl",
          "-display",
          "egl-headless"
        ],
        "variants": {
          "std": [
            "-vga",
            "std",
            "-display",
            "gtk"
          ],
          "safe": [
            "-vga",
            "std",
            "-display",
            "gtk",
            "-serial",
            "mon:stdio"
          ],
          "virtio-gl": [
            "-device",
            "virtio-vga-gl",
            "-display",
            "gtk,gl=on"
          ]
        }
      },
      "usb_tablet": true,
      "archinstall_config": {
        "hostname": "cachyos-local",
        "username": "lab",
        "password": "lab",
        "timezone": "Europe/Rome",
        "keyboard_layout": "it",
        "locale_lang": "it_IT",
        "locale_enc": "UTF-8",
        "bootloader": "Grub",
        "kernels": [
          "linux-cachyos"
        ],
        "audio": true,
        "inherit_live_pacman_conf": true,
        "live_login_prompt": "CachyOS login:",
        "live_shell_prompt": "root@CachyOS",
        "live_kernel_append": "systemd.unit=multi-user.target",
        "packages": [
          "cachyos-hooks",
          "cachyos-keyring",
          "cachyos-mirrorlist",
          "cachyos-v3-mirrorlist",
          "cachyos-v4-mirrorlist",
          "cachyos-rate-mirrors",
          "chwd",
          "linux-cachyos-headers",
          "cachyos-hello",
          "cachyos-kernel-manager",
          "cachyos-packageinstaller",
          "cachyos-settings",
          "cachyos-micro-settings",
          "cachyos-wallpapers",
          "cachyos-zsh-config",
          "cachyos-niri-noctalia",
          "sddm",
          "foot",
          "fuzzel",
          "polkit",
          "nss-mdns",
          "alsa-utils",
          "pavucontrol",
          "pipewire-alsa",
          "pipewire-pulse",
          "wireplumber",
          "gst-plugin-pipewire",
          "noto-fonts",
          "noto-fonts-emoji",
          "noto-fonts-cjk",
          "ttf-dejavu",
          "ttf-liberation",
          "ttf-meslo-nerd",
          "accountsservice",
          "bash-completion",
          "xdg-user-dirs",
          "xdg-utils",
          "mesa",
          "mesa-utils",
          "sof-firmware",
          "power-profiles-daemon",
          "upower",
          "alacritty",
          "btop",
          "fastfetch",
          "git",
          "micro",
          "nano",
          "vim",
          "rsync",
          "wget",
          "ripgrep",
          "firefox"
        ],
        "bootstrap_chroot_commands": [
          "systemctl enable sddm power-profiles-daemon",
          "install -d -m 755 /etc/sddm.conf.d && printf '[Autologin]\\nUser={{user}}\\nSession=niri\\n' > /etc/sddm.conf.d/autologin.conf",
          "install -d -o {{user}} -g {{user}} /home/{{user}}/.config/niri/cfg && printf '%s\\n' '// qemu-iso-lab: the VM power button (vmctl stop) must reach logind, which powers off.' '// niri would otherwise inhibit it and map XF86PowerOff to suspend.' 'input {' '    disable-power-key-handling' '}' > /home/{{user}}/.config/niri/cfg/vm-power.kdl && grep -q 'cfg/vm-power.kdl' /home/{{user}}/.config/niri/config.kdl 2>/dev/null || echo 'include \"./cfg/vm-power.kdl\"' >> /home/{{user}}/.config/niri/config.kdl && chown -R {{user}}:{{user}} /home/{{user}}/.config/niri"
        ]
      },
      "ssh_provision": {
        "hostname": "cachyos-local",
        "user": "lab",
        "ssh_host_port": 2223,
        "copy_from_host": [
          {
            "source": "vms/profile-files/cachyos-local/bin/cachyos-post-install",
            "dest": "/home/{{user}}/bin/cachyos-post-install",
            "dest_mode": "755"
          }
        ],
        "post_install_run": [
          "~/bin/cachyos-post-install"
        ]
      },
      "notes": "CachyOS installed unattended by bootstrap-archinstall: the desktop ISO is an archiso, so the pacstrap flow runs on it (installer_boot kernel, CachyOS serial prompts, live pacman.conf inherited by the target so the [cachyos] repository and linux-cachyos survive the first boot). The package set mirrors what Calamares installs for its 'Niri' desktop choice: cachyos-niri-noctalia (niri + Noctalia shell, CachyOS defaults) with SDDM autologin, plus the CachyOS base groups. Calamares itself remains available for a manual install (vmctl install)."
    },
