#!/usr/bin/env bash
set -euo pipefail

packages=(
  niri foot fuzzel xwayland-satellite
  xdg-desktop-portal xdg-desktop-portal-gnome xdg-desktop-portal-gtk xdg-user-dirs xdg-utils
  wl-clipboard cliphist grim slurp swappy
  nautilus gvfs gvfs-mtp gvfs-smb udisks2 udiskie
  pavucontrol playerctl upower power-profiles-daemon
  curl wget rsync unzip zip p7zip unrar less man-db man-pages bash-completion inetutils
  fastfetch btop tree jq ripgrep fd eza bat nano vim
  ttf-jetbrains-mono-nerd noto-fonts-cjk papirus-icon-theme adwaita-icon-theme
  gnome-keyring seahorse
  quickshell accountsservice go cava matugen
)

sudo pacman -S --noconfirm --needed "${packages[@]}"
xdg-user-dirs-update || true

mkdir -p \
  "$HOME/.config/niri" \
  "$HOME/.config/DankMaterialShell" \
  "$HOME/bin" \
  "$HOME/aurbuild"

chmod 0755 "$HOME/bin/arch-dms-nvidia-post-install"

build_and_install_aur() {
  local repo="$1"
  local expected="$2"
  local dir="$HOME/aurbuild/$repo"
  local pkg

  rm -rf "$dir"
  git clone "https://aur.archlinux.org/${repo}.git" "$dir"
  (
    cd "$dir"
    makepkg -Ccf --noconfirm
  )
  pkg="$(
    find "$dir" -maxdepth 1 -type f -name "${repo}-[0-9]*.pkg.tar.*" -printf "%T@ %p\n" |
      sort -nr |
      head -n1 |
      cut -d" " -f2-
  )"
  test -n "$pkg"
  test -s "$pkg"
  bsdtar -tf "$pkg" | grep -qx "$expected"
  sudo pacman -U --overwrite "*" --noconfirm "$pkg"
}

# dgop (monitor di sistema di Dank) e la shell dms: entrambi dall'AUR, compilati in Go.
build_and_install_aur dgop usr/bin/dgop
build_and_install_aur dms-shell-git usr/bin/dms
# La unit utente arriva dal pacchetto; se mancasse o fosse vuota (visto il 2026-09-02 dopo uno
# stop brusco della VM) la si prende dal sorgente AUR appena clonato, in /etc che prevale su /usr/lib.
if ! test -s /usr/lib/systemd/user/dms.service; then
  sudo install -Dm0644 "$HOME/aurbuild/dms-shell-git/dms.service" /etc/systemd/user/dms.service
fi

# dms parte come unit utente agganciata a graphical-session.target (che niri-session
# attiva): abilitata per tutti gli utenti, così non serve un bus di sessione via SSH.
sudo systemctl --global enable dms.service

command -v qs >/dev/null
command -v quickshell >/dev/null
command -v footclient >/dev/null
command -v fuzzel >/dev/null
command -v xwayland-satellite >/dev/null
command -v dms >/dev/null
command -v dgop >/dev/null
niri validate

# --- personal environment (dotfiles arrive from local.json copy_from_host) ------------
if command -v zsh >/dev/null && [ "$(getent passwd "$USER" | cut -d: -f7)" != "/usr/bin/zsh" ]; then
  sudo chsh -s /usr/bin/zsh "$USER"
fi
printf 'org.gnome.Ptyxis.desktop\nAlacritty.desktop\nfoot.desktop\n' > "$HOME/.config/xdg-terminals.list"
if [ -f "$HOME/.config/ptyxis.dconf" ] && command -v dconf >/dev/null; then
  dbus-run-session -- dconf load /org/gnome/Ptyxis/ < "$HOME/.config/ptyxis.dconf" || true
fi
fc-cache -f >/dev/null 2>&1 || true

# --- NVIDIA: built for bare metal, verified as far as a VM allows -----------------------
test -f /etc/modprobe.d/nvidia.conf
dkms status | grep -q nvidia
grep -q '^MODULES=(nvidia' /etc/mkinitcpio.conf
sudo grep -q 'nvidia-drm.modeset=1' /boot/grub/grub.cfg
systemctl is-enabled nvidia-hibernate nvidia-resume nvidia-suspend >/dev/null

sudo systemctl enable seatd greetd
sudo systemctl enable upower || true
sudo systemctl enable power-profiles-daemon || true
# Il contenuto passa da un file temporaneo: con `sudo ... /dev/stdin <<EOF` sudo (use_pty)
# può consegnare uno stdin vuoto e lasciare config.toml a zero byte (visto il 2026-09-02).
greetd_cfg="$(mktemp)"
cat > "$greetd_cfg" <<EOF
[terminal]
vt = 1

[initial_session]
command = "niri-session"
user = "$USER"

[default_session]
command = "agreety"
user = "greeter"
EOF
sudo install -D -m 0644 "$greetd_cfg" /etc/greetd/config.toml
rm -f "$greetd_cfg"
test -s /etc/greetd/config.toml

sudo systemctl restart greetd
