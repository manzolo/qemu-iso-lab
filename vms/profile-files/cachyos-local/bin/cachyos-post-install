#!/usr/bin/env bash
set -euo pipefail

# niri + Noctalia are installed by the bootstrap (cachyos-niri-noctalia); this only checks the result.
mkdir -p "$HOME/.config/niri"

command -v niri >/dev/null
niri --version
command -v noctalia-shell >/dev/null || command -v qs >/dev/null
systemctl is-enabled sddm
