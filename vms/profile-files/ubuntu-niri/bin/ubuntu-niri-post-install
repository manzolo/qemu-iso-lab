#!/usr/bin/env bash
set -euo pipefail

sudo add-apt-repository -y ppa:avengemedia/danklinux
sudo add-apt-repository -y ppa:avengemedia/dms
sudo apt update
sudo apt install -y niri dms
# DankMaterialShell brings its own bar: waybar on top of it paints a second, broken one.
sudo systemctl --global disable waybar.service || true
mkdir -p "$HOME/.config/niri"
command -v niri >/dev/null
niri --version

# greetd with autologin into niri, the same shape as the Arch and Fedora recipes. Without a
# display manager these profiles ended on a text login and niri had to be started by hand.
sudo apt install -y greetd
# Debian and Ubuntu name the greeter account _greetd; the Arch package uses greeter.
greeter_user=greeter
for candidate in _greetd greetd greeter; do
    if id "$candidate" >/dev/null 2>&1; then greeter_user=$candidate; break; fi
done
# The content goes through a temporary file: with `sudo ... /dev/stdin <<EOF` sudo (use_pty)
# can hand over an empty stdin and leave config.toml at zero bytes.
# Debian and Ubuntu ship greetd with Conflicts=getty@tty7: asking for vt 1 leaves agetty
# holding the terminal and the autologin session dies without a word in the journal.
greetd_vt=1
if systemctl cat greetd 2>/dev/null | grep -q "getty@tty7"; then greetd_vt=7; fi
greetd_cfg="$(mktemp)"
cat > "$greetd_cfg" <<CFG
[terminal]
vt = $greetd_vt

[initial_session]
command = "niri-session"
user = "$USER"

[default_session]
command = "agreety --cmd /bin/bash"
user = "$greeter_user"
CFG
sudo install -D -m 0644 "$greetd_cfg" /etc/greetd/config.toml
rm -f "$greetd_cfg"
test -s /etc/greetd/config.toml
# The niri and dms packages pull a full desktop stack in, gdm3 included, and it claims
# display-manager.service: `systemctl enable greetd` then fails outright (seen live).
for other in gdm3 gdm lightdm sddm; do
    sudo systemctl disable "$other" >/dev/null 2>&1 || true
done
sudo rm -f /etc/systemd/system/display-manager.service
sudo systemctl enable greetd
sudo systemctl set-default graphical.target
# Deliberately no `systemctl restart greetd` here: restarted mid-install its initial session
# does not survive and tty1 falls back to agetty. The profile asserts the desktop after the
# reboot that verify_after_reboot performs.
