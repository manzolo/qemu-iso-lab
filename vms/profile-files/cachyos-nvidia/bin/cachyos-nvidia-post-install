#!/usr/bin/env bash
# CachyOS + niri + NVIDIA open kernel modules (mainline branch, DKMS).
# Runs as the guest user with passwordless sudo after the unattended pacstrap install
# (niri + Noctalia come from cachyos-niri-noctalia, installed by the bootstrap).
set -euo pipefail

sudo pacman -Syu --noconfirm

# DKMS needs the headers of every installed CachyOS kernel (linux-cachyos, -lts, -bore, ...).
headers=()
while read -r kernel; do
  headers+=("${kernel}-headers")
done < <(pacman -Qq | grep -E '^linux-cachyos(-[a-z0-9]+)*$' | grep -vE '(-headers|-nvidia)$' || true)

sudo pacman -S --noconfirm --needed \
  foot niri \
  "${headers[@]}" \
  nvidia-open-dkms nvidia-utils nvidia-settings \
  opencl-nvidia libva-nvidia-driver

# The 32-bit userspace is for Steam, not for the desktop this profile verifies, and the
# cachyos repo (which shadows multilib) lets it fall behind: on 2026-09-16 it still shipped
# lib32-nvidia-utils 610.57.04-1, whose 'nvidia-utils=610.57.04' no longer resolved against
# the 615.71.09-2 the same repo had for 64-bit, and the whole transaction failed. Best effort.
if ! sudo pacman -S --noconfirm --needed lib32-nvidia-utils lib32-opencl-nvidia; then
  echo "==> WARNING: 32-bit NVIDIA userspace not installed (repo versions out of sync); continuing."
fi

# Wayland compositors need the DRM KMS interface of the NVIDIA driver.
printf 'options nvidia_drm modeset=1 fbdev=1\noptions nvidia NVreg_PreserveVideoMemoryAllocations=1\n' \
  | sudo tee /etc/modprobe.d/nvidia.conf >/dev/null
sudo systemctl enable nvidia-suspend nvidia-hibernate nvidia-resume 2>/dev/null || true

command -v niri >/dev/null
niri --version
pacman -Q nvidia-utils nvidia-open-dkms
# nvidia-smi reports no device inside the VM unless a GPU is passed through.
command -v nvidia-smi >/dev/null && (nvidia-smi || true)

# The NVIDIA driver check alone cannot tell whether the desktop shell starts.
bash "$HOME/bin/cachyos-post-install"
