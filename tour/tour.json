    {
      "id": "lab-git",
      "title": {
        "en": "Git from underneath: the Git lab",
        "it": "Git visto da sotto: il lab Git"
      },
      "duration": 271.4,
      "lab": "git-lab",
      "series": "labs",
      "steps": [
        {
          "t": 0.01,
          "cmd": "cd qemu-iso-lab"
        },
        {
          "t": 16.4,
          "cmd": "vmctl group install git-lab --yes"
        },
        {
          "t": 32.9,
          "cmd": "vmctl shell git-lab-server"
        },
        {
          "t": 60.47,
          "cmd": "cd ~/workspace && ls -a .git"
        },
        {
          "t": 65.65,
          "cmd": "ls /srv/git/lab.git    # the bare remote: the same files, no working tree"
        },
        {
          "t": 72.76,
          "cmd": "clear; git log --oneline --graph --all | head -20"
        },
        {
          "t": 80.39,
          "cmd": "git cat-file -p HEAD    # the commit object"
        },
        {
          "t": 87.9,
          "cmd": "git cat-file -p HEAD^{tree}    # the tree: a directory listing"
        },
        {
          "t": 95.28,
          "cmd": "git cat-file -p HEAD:hello.txt    # the blob: bytes, no name"
        },
        {
          "t": 102.13,
          "cmd": "clear; cat .git/HEAD; cat .git/refs/heads/main"
        },
        {
          "t": 108.73,
          "cmd": "git branch -a"
        },
        {
          "t": 114.61,
          "cmd": "git log --merges --oneline"
        },
        {
          "t": 120.27,
          "cmd": "git show --stat --format='%h %s%nMerge: %p' HEAD~3 | head -4"
        },
        {
          "t": 127.63,
          "cmd": "clear; git switch -c branch-a && echo 'Version A' > clash.txt && git add clash.txt && git commit -q -m 'branch-a: clash.txt'"
        },
        {
          "t": 133.8,
          "cmd": "git switch main && echo 'Version B' > clash.txt && git add clash.txt && git commit -q -m 'main: clash.txt'"
        },
        {
          "t": 139.63,
          "cmd": "git merge branch-a; cat clash.txt    # the markers"
        },
        {
          "t": 147.33,
          "cmd": "echo 'Resolved version' > clash.txt && git add clash.txt && git commit -q -m 'Merge: resolve clash.txt' && git log --oneline --graph -4"
        },
        {
          "t": 156.28,
          "cmd": "git reset -q --hard origin/main && git branch -D branch-a    # back as it was"
        },
        {
          "t": 162.03,
          "cmd": "clear; git switch feature/stash && echo 'More work in progress' >> wip.txt && git stash push -m 'WIP: my in-progress work'"
        },
        {
          "t": 168.8,
          "cmd": "git status --short; cat wip.txt; git stash list"
        },
        {
          "t": 175.47,
          "cmd": "git stash pop && cat wip.txt"
        },
        {
          "t": 181.19,
          "cmd": "git checkout -- wip.txt && git switch main"
        },
        {
          "t": 185.17,
          "cmd": "clear; git remote -v"
        },
        {
          "t": 189.7,
          "cmd": "git fetch origin && git log --oneline HEAD..origin/main    # there, not here (nothing)"
        },
        {
          "t": 196.09,
          "cmd": "echo pushed > pushed.txt && git add pushed.txt && git commit -q -m 'Add pushed.txt' && git log --oneline origin/main..HEAD    # here, not pushed yet"
        },
        {
          "t": 204.79,
          "cmd": "git reset -q --hard HEAD~1    # undo"
        },
        {
          "t": 208.63,
          "cmd": "clear; git log --oneline --graph main feature/stash | head -8"
        },
        {
          "t": 216.53,
          "cmd": "git log --merges main..feature/stash --oneline | wc -l    # 0: linear"
        },
        {
          "t": 223.06,
          "cmd": "clear; git flow version; git tag"
        },
        {
          "t": 228.32,
          "cmd": "git log --oneline --merges main"
        },
        {
          "t": 234.09,
          "cmd": "git log --oneline --graph develop -6"
        },
        {
          "t": 240.97,
          "cmd": "bash ~/reset-git-lab.sh"
        },
        {
          "t": 246.72,
          "cmd": "exit"
        },
        {
          "t": 249.8,
          "cmd": "vmctl group test git-lab"
        }
      ],
      "video": {
        "it": "lab-git.it.mp4",
        "en": "lab-git.en.mp4"
      },
      "poster": "lab-git.jpg",
      "subtitles": {
        "en": "lab-git.en.vtt",
        "it": "lab-git.it.vtt"
      }
    },
    {
      "id": "lab-lvm",
      "title": {
        "en": "LVM from scratch: the LVM lab",
        "it": "LVM da zero: il lab LVM"
      },
      "duration": 268.2,
      "lab": "lvm-lab",
      "series": "labs",
      "steps": [
        {
          "t": 0.03,
          "cmd": "cd qemu-iso-lab"
        },
        {
          "t": 21.73,
          "cmd": "vmctl group install lvm-lab --yes"
        },
        {
          "t": 37.68,
          "cmd": "vmctl shell lvm-lab-server"
        },
        {
          "t": 64.62,
          "cmd": "lsblk"
        },
        {
          "t": 71.33,
          "cmd": "DISKS=$(lsblk -dnpo NAME,SIZE,TYPE | awk '$2==\"2G\" && $3==\"disk\" {print $1}' | xargs); echo $DISKS"
        },
        {
          "t": 78.59,
          "cmd": "sudo pvs; sudo vgs; sudo lvs    # nothing yet"
        },
        {
          "t": 92.62,
          "cmd": "sudo pvcreate $DISKS"
        },
        {
          "t": 97.16,
          "cmd": "sudo pvs"
        },
        {
          "t": 102.41,
          "cmd": "sudo vgcreate labvg $DISKS"
        },
        {
          "t": 107.04,
          "cmd": "sudo vgs labvg"
        },
        {
          "t": 113.79,
          "cmd": "sudo lvcreate -L 1G -n data labvg"
        },
        {
          "t": 118.61,
          "cmd": "sudo lvcreate -L 1G -n logs labvg"
        },
        {
          "t": 123.37,
          "cmd": "sudo lvs labvg"
        },
        {
          "t": 128.26,
          "cmd": "sudo mkfs.ext4 -q /dev/labvg/data && sudo mkfs.xfs -q /dev/labvg/logs"
        },
        {
          "t": 135.35,
          "cmd": "sudo mkdir -p /mnt/lab-data /mnt/lab-logs && sudo mount /dev/labvg/data /mnt/lab-data && sudo mount /dev/labvg/logs /mnt/lab-logs"
        },
        {
          "t": 142.25,
          "cmd": "df -h /mnt/lab-data /mnt/lab-logs; sudo vgs labvg"
        },
        {
          "t": 149.94,
          "cmd": "echo before-growth | sudo tee /mnt/lab-data/keep"
        },
        {
          "t": 154.54,
          "cmd": "sudo lvextend -L +1G --resizefs labvg/data"
        },
        {
          "t": 162.91,
          "cmd": "df -h /mnt/lab-data; cat /mnt/lab-data/keep"
        },
        {
          "t": 170.67,
          "cmd": "echo version-1 | sudo tee /mnt/lab-data/file"
        },
        {
          "t": 175.01,
          "cmd": "sudo lvcreate -s -L 256M -n data-snap labvg/data"
        },
        {
          "t": 180.18,
          "cmd": "echo version-2 | sudo tee /mnt/lab-data/file    # the change to undo"
        },
        {
          "t": 185.03,
          "cmd": "sudo umount /mnt/lab-data; sudo lvconvert --merge labvg/data-snap"
        },
        {
          "t": 205.75,
          "cmd": "sudo lvchange -an labvg/data; sudo lvchange -ay labvg/data; sudo lvs labvg    # the snapshot is gone: merged"
        },
        {
          "t": 213.69,
          "cmd": "sudo mount /dev/labvg/data /mnt/lab-data; cat /mnt/lab-data/file    # version-1 again"
        },
        {
          "t": 221.6,
          "cmd": "sudo umount /mnt/lab-data /mnt/lab-logs; sudo vgremove -fy labvg"
        },
        {
          "t": 228.05,
          "cmd": "sudo pvremove -y $DISKS; sudo wipefs -a $DISKS"
        },
        {
          "t": 233.7,
          "cmd": "lsblk"
        },
        {
          "t": 239.07,
          "cmd": "exit"
        },
        {
          "t": 240.93,
          "cmd": "vmctl group test lvm-lab"
        }
      ],
      "video": {
        "it": "lab-lvm.it.mp4",
        "en": "lab-lvm.en.mp4"
      },
      "poster": "lab-lvm.jpg",
      "subtitles": {
        "en": "lab-lvm.en.vtt",
        "it": "lab-lvm.it.vtt"
      }
    },
