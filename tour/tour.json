        },
        {
          "t": 89.68,
          "cmd": "sudo tee /etc/wireguard/wg0.conf >/dev/null <<EOF\n[Interface]\nAddress = 10.10.0.2/24\nPrivateKey = $(cat privatekey)\n\n[Peer]\nPublicKey = FLqNJTEonX+sxsd+PgPOJaOehl1o4jNXLfKubRor2BM=\nEndpoint = 172.20.1.1:51820\nAllowedIPs = 10.10.0.1/32\nPersistentKeepalive = 25\nEOF"
