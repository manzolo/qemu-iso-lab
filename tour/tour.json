    {
      "id": "lab-ssh",
      "title": {
        "en": "Hardening SSH: the SSH lab",
        "it": "Blindare SSH: il lab SSH"
      },
      "duration": 299.0,
      "lab": "ssh-lab",
      "series": "labs",
      "steps": [
        {
          "t": 0.01,
          "cmd": "cd qemu-iso-lab"
        },
        {
          "t": 15.35,
          "cmd": "vmctl group install ssh-lab --yes"
        },
        {
          "t": 42.5,
          "cmd": "vmctl shell ssh-lab-server"
        },
        {
          "t": 68.63,
          "cmd": "systemctl is-active ssh"
        },
        {
          "t": 72.65,
          "cmd": "grep -E '^#?(PubkeyAuthentication|PasswordAuthentication|PermitRootLogin)' /etc/ssh/sshd_config"
        },
        {
          "t": 80.42,
          "cmd": "exit"
        },
        {
          "t": 81.39,
          "cmd": "vmctl shell ssh-lab-client"
        },
        {
          "t": 88.03,
          "cmd": "ssh-keygen -t ed25519 -f ~/.ssh/lab_key -N '' -C lab"
        },
        {
          "t": 93.68,
          "cmd": "ssh-keygen -l -f ~/.ssh/lab_key.pub"
        },
        {
          "t": 98.95,
          "cmd": "ssh-keygen -t rsa -b 4096 -f ~/.ssh/lab_rsa -N '' -C lab -q && ssh-keygen -l -f ~/.ssh/lab_rsa.pub"
        },
        {
          "t": 109.06,
          "cmd": "timeout 3 bash -c 'echo > /dev/tcp/172.20.2.1/22' || echo 'port 22: closed from the segment'"
        },
        {
          "t": 121.4,
          "cmd": "knock 172.20.2.1 7000 8000 9000 && sleep 2"
        },
        {
          "t": 126.73,
          "cmd": "timeout 3 bash -c 'echo > /dev/tcp/172.20.2.1/22' && echo 'port 22: open for 172.20.2.2'"
        },
        {
          "t": 134.4,
          "cmd": "exit"
        },
        {
          "t": 135.37,
          "cmd": "vmctl shell ssh-lab-server"
        },
        {
          "t": 142.25,
          "cmd": "sudo cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak"
        },
        {
          "t": 146.22,
          "cmd": "sudo sed -i 's/^#\\?PermitRootLogin.*/PermitRootLogin no/; s/^#\\?MaxAuthTries.*/MaxAuthTries 3/' /etc/ssh/sshd_config"
        },
        {
          "t": 151.87,
          "cmd": "sudo sshd -t && echo 'config valid' && sudo systemctl reload ssh"
        },
        {
          "t": 157.34,
          "cmd": "grep -E '^(PermitRootLogin|MaxAuthTries)' /etc/ssh/sshd_config"
        },
        {
          "t": 163.86,
          "cmd": "sudo cp /etc/ssh/sshd_config.bak /etc/ssh/sshd_config && sudo systemctl reload ssh    # back as it was"
        },
        {
          "t": 170.19,
          "cmd": "sudo fail2ban-client status sshd"
        },
        {
          "t": 177.22,
          "cmd": "exit"
        },
        {
          "t": 180.28,
          "cmd": "vmctl shell ssh-lab-client"
        },
        {
          "t": 187.01,
          "cmd": "for i in 1 2 3 4; do sshpass -p nope ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o PreferredAuthentications=password -o PubkeyAuthentication=no demo@172.20.2.1 true 2>/dev/null; echo \"attempt $i refused\"; done"
        },
        {
          "t": 203.75,
          "cmd": "exit"
        },
        {
          "t": 204.77,
          "cmd": "vmctl shell ssh-lab-server"
        },
        {
          "t": 211.48,
          "cmd": "sleep 3; sudo fail2ban-client status sshd | grep -A2 'Banned IP'"
        },
        {
          "t": 222.69,
          "cmd": "sudo fail2ban-client set sshd unbanip 172.20.2.2"
        },
        {
          "t": 227.48,
          "cmd": "exit"
        },
