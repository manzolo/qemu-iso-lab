    {
      "id": "lab-docker",
      "title": {
        "en": "Docker from the first container: the Docker lab",
        "it": "Docker dal primo container: il lab Docker"
      },
      "duration": 231.3,
      "lab": "docker-lab",
      "series": "labs",
      "steps": [
        {
          "t": 0.01,
          "cmd": "cd qemu-iso-lab"
        },
        {
          "t": 15.84,
          "cmd": "vmctl group install docker-lab --yes"
        },
        {
          "t": 32.52,
          "cmd": "vmctl shell docker-lab-server"
        },
        {
          "t": 59.37,
          "cmd": "systemctl is-active docker; docker version --format 'server {{.Server.Version}}'"
        },
        {
          "t": 65.28,
          "cmd": "docker info --format '{{.Driver}} storage, {{.Containers}} containers, {{.Images}} images'"
        },
        {
          "t": 71.38,
          "cmd": "id -nG | tr ' ' '\\n' | grep -x docker    # why no sudo is needed"
        },
        {
          "t": 77.47,
          "cmd": "docker image ls"
        },
        {
          "t": 82.86,
          "cmd": "docker image history alpine:3.20"
        },
        {
          "t": 89.61,
          "cmd": "docker run --rm --pull never alpine:3.20 cat /etc/os-release | head -2"
        },
        {
          "t": 96.06,
          "cmd": "docker run -d --name lab-web -p 8080:80 --pull never nginx:1.27-alpine"
        },
        {
          "t": 102.05,
          "cmd": "docker ps"
        },
        {
          "t": 107.55,
          "cmd": "curl -s localhost:8080 | grep -o '<title>.*</title>'"
        },
        {
          "t": 114.08,
          "cmd": "docker exec lab-web nginx -v"
        },
        {
          "t": 119.0,
          "cmd": "docker logs --tail 3 lab-web"
        },
        {
          "t": 125.01,
          "cmd": "docker inspect -f '{{.State.Status}} {{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' lab-web"
        },
        {
          "t": 132.19,
          "cmd": "docker rm -f lab-web"
        },
        {
          "t": 136.17,
          "cmd": "docker volume create lab-data"
        },
        {
          "t": 139.89,
          "cmd": "docker run --rm --pull never -v lab-data:/data alpine:3.20 sh -c 'echo kept > /data/note'"
        },
        {
          "t": 145.3,
          "cmd": "docker run --rm --pull never -v lab-data:/data alpine:3.20 cat /data/note    # a second container reads it"
        },
        {
          "t": 152.56,
          "cmd": "docker volume rm lab-data"
        },
        {
          "t": 156.17,
          "cmd": "mkdir -p ~/compose-demo/html && echo '<h1>hello from compose</h1>' > ~/compose-demo/html/index.html"
        },
        {
          "t": 160.99,
          "cmd": "cat > ~/compose-demo/compose.yaml <<'EOF'\nservices:\n  web:\n    image: nginx:1.27-alpine\n    pull_policy: never\n    ports:\n      - \"8081:80\"\n    volumes:\n      - ./html:/usr/share/nginx/html:ro\nEOF"
        },
        {
          "t": 167.7,
          "cmd": "cd ~/compose-demo && docker compose up -d"
        },
        {
          "t": 172.62,
          "cmd": "docker compose ps; curl -s localhost:8081"
        },
        {
          "t": 179.04,
          "cmd": "docker compose down && cd && rm -rf ~/compose-demo"
        },
        {
          "t": 184.19,
          "cmd": "mkdir -p ~/build-demo && cd ~/build-demo && printf 'FROM alpine:3.20\\nRUN echo built-in-the-lab > /message\\nCMD [\"cat\", \"/message\"]\\n' > Dockerfile && cat Dockerfile"
        },
        {
          "t": 192.75,
          "cmd": "docker build -q -t lab-hello . && docker run --rm lab-hello"
        },
        {
          "t": 200.93,
          "cmd": "docker image rm lab-hello >/dev/null && cd && rm -rf ~/build-demo && docker ps -a"
        },
        {
          "t": 206.89,
          "cmd": "exit"
        },
        {
          "t": 208.85,
          "cmd": "vmctl group test docker-lab"
        }
      ],
      "video": {
