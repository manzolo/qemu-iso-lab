    {
      "id": "lab-zfs",
      "title": {
        "en": "ZFS from the first pool: the ZFS lab",
        "it": "ZFS dal primo pool: il lab ZFS"
      },
      "duration": 256.8,
      "lab": "zfs-lab",
      "series": "labs",
      "steps": [
        {
          "t": 0.01,
          "cmd": "cd qemu-iso-lab"
        },
        {
          "t": 17.79,
          "cmd": "vmctl group install zfs-lab --yes"
        },
        {
          "t": 34.99,
          "cmd": "vmctl shell zfs-lab-server"
        },
        {
          "t": 62.54,
          "cmd": "DISKS=$(lsblk -dnpo NAME,SIZE,TYPE | awk '$2==\"2G\" && $3==\"disk\" {print $1}' | xargs); echo $DISKS"
        },
        {
          "t": 69.84,
          "cmd": "sudo zpool list"
        },
        {
          "t": 74.33,
          "cmd": "sudo zpool create -f tank raidz $DISKS && sudo zpool status tank"
        },
        {
          "t": 84.27,
          "cmd": "sudo zpool list -o name,size,alloc,free,health tank; df -h /tank"
        },
        {
          "t": 91.98,
          "cmd": "clear; sudo zfs create tank/data && sudo zfs set compression=lz4 tank/data"
        },
        {
          "t": 97.18,
          "cmd": "yes 'the same line, again and again, compresses very well' | head -c 50M | sudo tee /tank/data/text.bin >/dev/null; sync"
        },
        {
          "t": 105.67,
          "cmd": "sudo zfs get -H -o value compressratio tank/data"
        },
        {
          "t": 111.84,
          "cmd": "sudo zfs list -o name,used,avail,refer,mountpoint"
        },
        {
          "t": 119.11,
          "cmd": "clear; echo version-1 | sudo tee /tank/data/file && sudo zfs snapshot tank/data@v1"
        },
        {
          "t": 124.49,
          "cmd": "echo version-2 | sudo tee /tank/data/file && sudo zfs diff tank/data@v1"
        },
        {
          "t": 131.16,
          "cmd": "sudo zfs rollback tank/data@v1 && cat /tank/data/file    # version-1 again"
        },
        {
          "t": 138.33,
          "cmd": "clear; sudo zpool offline tank $(echo $DISKS | cut -d' ' -f1) && sudo zpool status tank"
        },
        {
          "t": 147.79,
          "cmd": "echo written-while-degraded | sudo tee /tank/data/degraded"
        },
        {
          "t": 153.13,
          "cmd": "sudo zpool online tank $(echo $DISKS | cut -d' ' -f1) && sleep 3 && sudo zpool status tank"
        },
        {
          "t": 165.02,
          "cmd": "clear; sudo zpool scrub tank && sleep 4 && sudo zpool status tank"
        },
        {
          "t": 177.94,
          "cmd": "clear; sudo zfs snapshot tank/data@backup && sudo zfs send tank/data@backup | sudo zfs receive tank/copy"
        },
        {
          "t": 186.73,
          "cmd": "sudo zfs list; cat /tank/copy/file"
        },
        {
          "t": 193.62,
          "cmd": "sudo zfs destroy -r tank/copy"
        },
        {
          "t": 201.13,
          "cmd": "clear; sudo zpool destroy tank && sudo zpool create -f tank mirror $(echo $DISKS | cut -d' ' -f1,2) mirror $(echo $DISKS | cut -d' ' -f3,4)"
        },
        {
          "t": 209.2,
          "cmd": "sudo zpool status tank; sudo zfs list tank"
        },
        {
          "t": 217.75,
          "cmd": "sudo zpool destroy tank; for d in $DISKS; do sudo zpool labelclear -f $d; sudo wipefs -a $d; done; lsblk"
        },
        {
          "t": 228.73,
          "cmd": "exit"
        },
        {
          "t": 230.79,
          "cmd": "vmctl group test zfs-lab"
        }
      ],
      "video": {
        "it": "lab-zfs.it.mp4",
        "en": "lab-zfs.en.mp4"
      },
      "poster": "lab-zfs.jpg",
      "subtitles": {
        "en": "lab-zfs.en.vtt",
        "it": "lab-zfs.it.vtt"
      }
    }
  ]
